{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ============================================================\n# NONLINEAR ODE - LOGISTIC PINN + RK4 + EXACT SOLUTION\n#\n# Equation:-\n#       dx/dt = r*x\n#       dx/dt = r*x*(1 - x/K)\n#\n# Initial condition:\n#       x(0) = 100\n#\n# Parameters:\n#       r = 0.8\n#\n# Exact solution:\n#       x(t) = 100*exp(0.8*t)\n# ============================================================\n\n\n# ============================================================\n# IMPORTS\n# ============================================================\n\nimport os\nimport numpy as np\nimport tensorflow as tf\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\n\n# ============================================================\n# EXPERIMENT SETTINGS\n# ============================================================\n\nepoch_list = [1000,5000,10000]\n\nyears_list = [1,3,5]\n\nwindows_list = [1,3,5]\n\nphysics_points = 100\n\ntest_points = 500\n\nlearning_rate = 0.001\n\n\n# ============================================================\n# EQUATION PARAMETERS\n# ============================================================\n\n# r = 0.8\n\n# initial_x = 100.0\n\nr = 0.8\nK = 1000.0\ninitial_x = 100.0\n\n\n# ============================================================\n# RESULT FOLDERS\n# ============================================================\n\nos.makedirs(\n    \"results_nonlinear\",\n    exist_ok=True\n)\n\nos.makedirs(\n    \"results_nonlinear/plots\",\n    exist_ok=True\n)\n\nos.makedirs(\n    \"results_nonlinear/loss_plots\",\n    exist_ok=True\n)\n\n\n# ============================================================\n# PINN MODEL\n# ============================================================\n\ndef build_model():\n\n    model = tf.keras.Sequential([\n\n        tf.keras.layers.Input(\n            shape=(1,)\n        ),\n\n        tf.keras.layers.Dense(\n            100,\n            activation=\"tanh\"\n        ),\n\n        tf.keras.layers.Dense(\n            100,\n            activation=\"tanh\"\n        ),\n\n        tf.keras.layers.Dense(\n            100,\n            activation=\"tanh\"\n        ),\n\n        tf.keras.layers.Dense(\n            1,\n            activation=\"linear\"\n        )\n    ])\n\n    return model\n\n\n# ============================================================\n# PHYSICS RESIDUAL\n#\n# Equation:\n#\n#       dx/dt = r*x\n#\n# Therefore:\n#\n#       dx/dt - r*x = 0\n# ============================================================\n\ndef physics_residual(model, t):\n\n    with tf.GradientTape() as tape:\n\n        tape.watch(t)\n\n        x = model(\n            t,\n            training=True\n        )\n\n    dx_dt = tape.gradient(\n        x,\n        t\n    )\n\n    # residual = (\n    #     dx_dt\n    #     - r * x\n    # )\n    residual = dx_dt - r * x * (1 - x / K)\n\n    return residual, x\n\n\n# ============================================================\n# RK4 SOLVER\n# ============================================================\n\ndef rk4_solution(t):\n\n    t = np.asarray(t).flatten()\n\n    x = np.zeros(\n        len(t)\n    )\n\n    x[0] = initial_x\n\n    for i in range(\n        len(t) - 1\n    ):\n\n        h = (\n            t[i + 1]\n            - t[i]\n        )\n\n        # ----------------------------------------------------\n        # ODE\n        # dx/dt = r*x\n        # ----------------------------------------------------\n\n        def f(\n            t_value,\n            x_value\n        ):\n            # return r * x_value\n            \n            return r * x_value * (1 - x_value / K)\n\n            \n\n        # ----------------------------------------------------\n        # RK4\n        # ----------------------------------------------------\n\n        k1 = f(\n            t[i],\n            x[i]\n        )\n\n        k2 = f(\n            t[i] + h / 2,\n            x[i] + h * k1 / 2\n        )\n\n        k3 = f(\n            t[i] + h / 2,\n            x[i] + h * k2 / 2\n        )\n\n        k4 = f(\n            t[i] + h,\n            x[i] + h * k3\n        )\n\n        x[i + 1] = (\n            x[i]\n            +\n            (h / 6)\n            * (\n                k1\n                + 2 * k2\n                + 2 * k3\n                + k4\n            )\n        )\n\n    return x\n\n\n# ============================================================\n# RUN ONE EXPERIMENT\n# ============================================================\n\ndef run_experiment(\n    epoch,\n    years,\n    windows\n):\n\n    print(\n        \"\\n============================================================\"\n    )\n\n    print(\n        \"NONLINEAR ODE - LOGISTIC\"\n    )\n\n    print(\n        f\"Epochs={epoch}, \"\n        f\"Years={years}, \"\n        f\"Windows={windows}\"\n    )\n\n    print(\n        \"============================================================\"\n    )\n\n\n    # ========================================================\n    # TIME SETTINGS\n    # ========================================================\n\n    total_years = years\n\n    num_windows = windows\n\n    years_per_window = (\n        total_years\n        / num_windows\n    )\n\n\n    # ========================================================\n    # NEW MODEL FOR EACH EXPERIMENT\n    # ========================================================\n\n    model = build_model()\n\n    optimizer = tf.keras.optimizers.Adam(\n        learning_rate=learning_rate\n    )\n\n\n    # ========================================================\n    # INITIAL CONDITION\n    # ========================================================\n\n    current_x0 = tf.constant(\n        [[initial_x]],\n        dtype=tf.float32\n    )\n\n\n    # ========================================================\n    # LOSS HISTORY\n    # ========================================================\n\n    loss_history = []\n\n\n    # ========================================================\n    # STORE PINN RESULTS\n    # ========================================================\n\n    all_t = []\n\n    all_x = []\n\n\n    # ========================================================\n    # TIME-MARCHING WINDOWS\n    # ========================================================\n\n    for w in range(\n        num_windows\n    ):\n\n        t_start = (\n            w\n            * years_per_window\n        )\n\n        t_end = (\n            (w + 1)\n            * years_per_window\n        )\n\n        print(\n            f\"Window {w + 1}/{num_windows}: \"\n            f\"{t_start:.4f} -> {t_end:.4f}\"\n        )\n\n\n        # ----------------------------------------------------\n        # PHYSICS POINTS\n        # ----------------------------------------------------\n\n        t_physics = tf.linspace(\n            t_start,\n            t_end,\n            physics_points\n        )\n\n        t_physics = tf.reshape(\n            t_physics,\n            (-1, 1)\n        )\n\n\n        # ----------------------------------------------------\n        # INITIAL POINT\n        # ----------------------------------------------------\n\n        t_init = tf.constant(\n            [[t_start]],\n            dtype=tf.float32\n        )\n\n\n        # ====================================================\n        # TRAINING\n        # ====================================================\n\n        for ep in range(\n            epoch\n        ):\n\n            with tf.GradientTape() as tape:\n\n                # --------------------------------------------\n                # PHYSICS LOSS\n                # --------------------------------------------\n\n                with tf.GradientTape() as physics_tape:\n\n                    physics_tape.watch(\n                        t_physics\n                    )\n\n                    x_physics = model(\n                        t_physics,\n                        training=True\n                    )\n\n                dx_dt = physics_tape.gradient(\n                    x_physics,\n                    t_physics\n                )\n\n                # residual = (\n                #     dx_dt\n                #     - r * x_physics\n                # )\n                residual = dx_dt - r * x_physics * (1 - x_physics / K)\n\n                physics_loss = tf.reduce_mean(\n                    tf.square(\n                        residual\n                    )\n                )\n\n\n                # --------------------------------------------\n                # INITIAL CONDITION LOSS\n                # --------------------------------------------\n\n                x_init_pred = model(\n                    t_init,\n                    training=True\n                )\n\n                ic_loss = tf.reduce_mean(\n                    tf.square(\n                        x_init_pred\n                        - current_x0\n                    )\n                )\n\n\n                # --------------------------------------------\n                # TOTAL LOSS\n                # --------------------------------------------\n\n                loss = (\n                    physics_loss\n                    +\n                    10.0 * ic_loss\n                )\n\n\n            # ------------------------------------------------\n            # UPDATE MODEL\n            # ------------------------------------------------\n\n            gradients = tape.gradient(\n                loss,\n                model.trainable_variables\n            )\n\n            optimizer.apply_gradients(\n                zip(\n                    gradients,\n                    model.trainable_variables\n                )\n            )\n\n\n            # ------------------------------------------------\n            # SAVE LOSS\n            # ------------------------------------------------\n\n            loss_history.append(\n                float(\n                    loss.numpy()\n                )\n            )\n\n\n        print(\n            f\"Final window loss: \"\n            f\"{loss_history[-1]:.8e}\"\n        )\n\n\n        # ====================================================\n        # PINN PREDICTION\n        # ====================================================\n\n        points_per_window = (\n            test_points\n            // num_windows\n        ) + 1\n\n        t_window = np.linspace(\n            t_start,\n            t_end,\n            points_per_window\n        )\n\n        t_window_tf = tf.convert_to_tensor(\n            t_window.reshape(-1, 1),\n            dtype=tf.float32\n        )\n\n        x_window = model(\n            t_window_tf,\n            training=False\n        ).numpy().flatten()\n\n\n        # ----------------------------------------------------\n        # REMOVE DUPLICATE WINDOW BOUNDARY\n        # ----------------------------------------------------\n\n        if w > 0:\n\n            t_window = t_window[1:]\n\n            x_window = x_window[1:]\n\n\n        all_t.extend(\n            t_window\n        )\n\n        all_x.extend(\n            x_window\n        )\n\n\n        # ====================================================\n        # UPDATE INITIAL CONDITION\n        # FOR NEXT WINDOW\n        # ====================================================\n\n        t_boundary = tf.constant(\n            [[t_end]],\n            dtype=tf.float32\n        )\n\n        current_x0 = model(\n            t_boundary,\n            training=False\n        )\n\n\n    # ========================================================\n    # FINAL PINN DATA\n    # ========================================================\n\n    t_nn = np.array(\n        all_t\n    )\n\n    x_nn = np.array(\n        all_x\n    )\n\n\n    # --------------------------------------------------------\n    # SORT BY TIME\n    # --------------------------------------------------------\n\n    order = np.argsort(\n        t_nn\n    )\n\n    t_nn = t_nn[order]\n\n    x_nn = x_nn[order]\n\n\n    # ========================================================\n    # RK4 AT THE SAME POINTS\n    # ========================================================\n\n    x_rk4 = rk4_solution(\n        t_nn\n    )\n\n\n    # ========================================================\n    # EXACT SOLUTION\n    # ========================================================\n\n    # x_exact = (\n    #     initial_x\n    #     * np.exp(\n    #         r * t_nn\n    #     )\n    # )\n\n    x_exact = K / (1 + ((K - initial_x) / initial_x) * np.exp(-r * t_nn))\n\n\n\n    # ========================================================\n    # SAVE SOLUTION VALUES\n    # ========================================================\n\n    solution_df = pd.DataFrame({\n\n        \"t\": t_nn,\n\n        \"PINN\": x_nn,\n\n        \"RK4\": x_rk4,\n\n        \"Exact\": x_exact\n\n    })\n\n\n    solution_file = (\n        f\"results_nonlinear/\"\n        f\"solution_epochs_{epoch}_\"\n        f\"years_{years}_\"\n        f\"windows_{windows}.csv\"\n    )\n\n\n    solution_df.to_csv(\n        solution_file,\n        index=False\n    )\n\n\n    # ========================================================\n    # PINN VS RK4 ERROR\n    # ========================================================\n\n    error = (\n        x_nn\n        - x_rk4\n    )\n\n    mse = np.mean(\n        np.square(\n            error\n        )\n    )\n\n    rmse = np.sqrt(\n        mse\n    )\n\n    relative_l2_error = (\n        np.linalg.norm(\n            error\n        )\n        /\n        np.linalg.norm(\n            x_rk4\n        )\n    )\n\n\n    # ========================================================\n    # FINAL LOSS\n    # ========================================================\n\n    final_loss = (\n        loss_history[-1]\n    )\n\n\n    # ========================================================\n    # PINN VS RK4 PLOT\n    # ========================================================\n\n    result_plot = (\n        f\"results_nonlinear/plots/\"\n        f\"epochs_{epoch}_\"\n        f\"years_{years}_\"\n        f\"windows_{windows}.png\"\n    )\n\n\n    plt.figure(\n        figsize=(10, 6)\n    )\n\n    plt.plot(\n        t_nn,\n        x_rk4,\n        label=\"RK4\",\n        linewidth=2\n    )\n\n    plt.plot(\n        t_nn,\n        x_nn,\n        \"--\",\n        label=\"PINN\",\n        linewidth=2\n    )\n\n    plt.xlabel(\n        \"t\"\n    )\n\n    plt.ylabel(\n        \"x(t)\"\n    )\n\n    plt.title(\n        f\"NONLINEAR ODE - LOGISTIC: PINN vs RK4\\n\"\n        f\"Epochs={epoch}, \"\n        f\"Years={years}, \"\n        f\"Windows={windows}\"\n    )\n\n    plt.legend()\n\n    plt.grid(\n        True\n    )\n\n    plt.tight_layout()\n\n    plt.savefig(\n        result_plot,\n        dpi=300,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()\n\n\n    # ========================================================\n    # NEW: COMPARISON PLOTS\n    # ========================================================\n\n\n    # --------------------------------------------------------\n    # 1. EXACT VS PINN\n    # --------------------------------------------------------\n\n    plt.figure(\n        figsize=(10, 6)\n    )\n\n    plt.plot(\n        t_nn,\n        x_exact,\n        label=\"Exact\",\n        linewidth=2\n    )\n\n    plt.plot(\n        t_nn,\n        x_nn,\n        linestyle=\"--\",\n        label=\"PINN\",\n        linewidth=2\n    )\n\n    plt.xlabel(\n        \"Time\"\n    )\n\n    plt.ylabel(\n        \"x(t)\"\n    )\n\n    plt.title(\n        f\"Exact vs PINN | \"\n        f\"Epochs={epoch}, \"\n        f\"Years={years}, \"\n        f\"Windows={windows}\"\n    )\n\n    plt.legend()\n\n    plt.grid(\n        True\n    )\n\n    plt.tight_layout()\n\n    plt.savefig(\n        f\"results_nonlinear/plots/\"\n        f\"exact_vs_pinn_epochs_{epoch}_\"\n        f\"years_{years}_\"\n        f\"windows_{windows}.png\",\n        dpi=300,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()\n\n\n    # --------------------------------------------------------\n    # 2. RK4 VS PINN\n    # --------------------------------------------------------\n\n    plt.figure(\n        figsize=(10, 6)\n    )\n\n    plt.plot(\n        t_nn,\n        x_rk4,\n        label=\"RK4\",\n        linewidth=2\n    )\n\n    plt.plot(\n        t_nn,\n        x_nn,\n        linestyle=\"--\",\n        label=\"PINN\",\n        linewidth=2\n    )\n\n    plt.xlabel(\n        \"Time\"\n    )\n\n    plt.ylabel(\n        \"x(t)\"\n    )\n\n    plt.title(\n        f\"RK4 vs PINN | \"\n        f\"Epochs={epoch}, \"\n        f\"Years={years}, \"\n        f\"Windows={windows}\"\n    )\n\n    plt.legend()\n\n    plt.grid(\n        True\n    )\n\n    plt.tight_layout()\n\n    plt.savefig(\n        f\"results_nonlinear/plots/\"\n        f\"rk4_vs_pinn_epochs_{epoch}_\"\n        f\"years_{years}_\"\n        f\"windows_{windows}.png\",\n        dpi=300,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()\n\n\n    # --------------------------------------------------------\n    # 3. RK4 VS EXACT\n    # --------------------------------------------------------\n\n    plt.figure(\n        figsize=(10, 6)\n    )\n\n    plt.plot(\n        t_nn,\n        x_rk4,\n        label=\"RK4\",\n        linewidth=2\n    )\n\n    plt.plot(\n        t_nn,\n        x_exact,\n        linestyle=\"--\",\n        label=\"Exact\",\n        linewidth=2\n    )\n\n    plt.xlabel(\n        \"Time\"\n    )\n\n    plt.ylabel(\n        \"x(t)\"\n    )\n\n    plt.title(\n        f\"RK4 vs Exact | \"\n        f\"Epochs={epoch}, \"\n        f\"Years={years}, \"\n        f\"Windows={windows}\"\n    )\n\n    plt.legend()\n\n    plt.grid(\n        True\n    )\n\n    plt.tight_layout()\n\n    plt.savefig(\n        f\"results_nonlinear/plots/\"\n        f\"rk4_vs_exact_epochs_{epoch}_\"\n        f\"years_{years}_\"\n        f\"windows_{windows}.png\",\n        dpi=300,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()\n\n\n    # --------------------------------------------------------\n    # 4. ALL THREE TOGETHER\n    # --------------------------------------------------------\n\n    plt.figure(\n        figsize=(10, 6)\n    )\n\n    plt.plot(\n        t_nn,\n        x_exact,\n        label=\"Exact\",\n        linewidth=2\n    )\n\n    plt.plot(\n        t_nn,\n        x_rk4,\n        linestyle=\"--\",\n        label=\"RK4\",\n        linewidth=2\n    )\n\n    plt.plot(\n        t_nn,\n        x_nn,\n        linestyle=\":\",\n        label=\"PINN\",\n        linewidth=2\n    )\n\n    plt.xlabel(\n        \"Time\"\n    )\n\n    plt.ylabel(\n        \"x(t)\"\n    )\n\n    plt.title(\n        f\"PINN vs RK4 vs Exact | \"\n        f\"Epochs={epoch}, \"\n        f\"Years={years}, \"\n        f\"Windows={windows}\"\n    )\n\n    plt.legend()\n\n    plt.grid(\n        True\n    )\n\n    plt.tight_layout()\n\n    plt.savefig(\n        f\"results_nonlinear/plots/\"\n        f\"all_three_epochs_{epoch}_\"\n        f\"years_{years}_\"\n        f\"windows_{windows}.png\",\n        dpi=300,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()\n\n\n    # ========================================================\n    # EPOCH LOSS PLOT\n    # ========================================================\n\n    loss_plot = (\n        f\"results_nonlinear/loss_plots/\"\n        f\"epochs_{epoch}_\"\n        f\"years_{years}_\"\n        f\"windows_{windows}_loss.png\"\n    )\n\n\n    plt.figure(\n        figsize=(10, 6)\n    )\n\n    plt.plot(\n        range(\n            1,\n            len(loss_history) + 1\n        ),\n        loss_history\n    )\n\n    plt.xlabel(\n        \"Epoch\"\n    )\n\n    plt.ylabel(\n        \"Loss\"\n    )\n\n    plt.title(\n        f\"NONLINEAR ODE - LOGISTIC Training Loss\\n\"\n        f\"Epochs={epoch}, \"\n        f\"Years={years}, \"\n        f\"Windows={windows}\"\n    )\n\n    plt.grid(\n        True\n    )\n\n    plt.tight_layout()\n\n    plt.savefig(\n        loss_plot,\n        dpi=300,\n        bbox_inches=\"tight\"\n    )\n\n    plt.close()\n\n\n    # ========================================================\n    # RETURN RESULTS\n    # ========================================================\n\n    return {\n\n        \"epoch\": epoch,\n\n        \"years\": years,\n\n        \"windows\": windows,\n\n        \"loss\": final_loss,\n\n        \"RMSE\": rmse,\n\n        \"MSE\": mse,\n\n        \"EPOCHS LOSS\": final_loss,\n\n        \"relative_L2_error\":\n            relative_l2_error\n\n    }\n\n\n# ============================================================\n# RUN ALL EXPERIMENTS\n# ============================================================\n\nresults = []\n\n\nfor epoch in epoch_list:\n\n    for years in years_list:\n\n        for windows in windows_list:\n\n            result = run_experiment(\n                epoch,\n                years,\n                windows\n            )\n\n            results.append(\n                result\n            )\n\n\n# ============================================================\n# RESULTS TABLE\n# ============================================================\n\nresults_df = pd.DataFrame(\n    results\n)\n\n\nresults_df = results_df.sort_values(\n    by=\"relative_L2_error\"\n).reset_index(\n    drop=True\n)\n\n\nprint(\n    \"\\n============================================================\"\n)\n\nprint(\n    \"NONLINEAR ODE - LOGISTIC RESULTS\"\n)\n\nprint(\n    \"==========================