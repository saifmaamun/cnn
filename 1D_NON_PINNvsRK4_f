{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ============================================================================\n# CELL 1 — IMPORTS, CONFIGURATIONS, AND VARIABLES\n# ============================================================================\n\nimport gc\nimport random\nimport shutil\nimport time\nfrom pathlib import Path\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nimport tensorflow as tf\nfrom IPython.display import Image, display\n\n\n# ---------------------------------------------------------------------------\n# Reproducibility and device setup\n# ---------------------------------------------------------------------------\nSEED = 42\nnp.random.seed(SEED)\nrandom.seed(SEED)\ntf.random.set_seed(SEED)\n\n# Allow TensorFlow to allocate GPU memory as needed, if supported by Kaggle.\nfor _gpu in tf.config.list_physical_devices(\"GPU\"):\n    try:\n        tf.config.experimental.set_memory_growth(_gpu, True)\n    except RuntimeError:\n        # GPU memory may already be initialized in some notebook sessions.\n        pass\n\nprint(\"TensorFlow:\", tf.__version__)\nprint(\"Detected GPUs:\", tf.config.list_physical_devices(\"GPU\"))\nprint(\"Note: this script does not distribute training across both T4 GPUs.\")\n\n\n# ---------------------------------------------------------------------------\n# Experiment configurations\n# Three epoch/width pairs, each tested with IC weights 1 and 10.\n# Total: six experiments.\n# ---------------------------------------------------------------------------\nBASE_CONFIGS = [\n    (1000, 50),\n    (5000, 100),\n    (10000, 150),\n]\n\nIC_WEIGHTS = [1.0, 10.0]\n\nCONFIGS = [\n    (epochs, neurons, ic_weight)\n    for ic_weight in IC_WEIGHTS\n    for epochs, neurons in BASE_CONFIGS\n]\n\n\n# ---------------------------------------------------------------------------\n# Fixed ODE and PINN settings\n# ---------------------------------------------------------------------------\nR = 0.8\nK = 1000.0\nINITIAL_X = 100.0\nTOTAL_TIME = 1.0\n\nWINDOWS = 5\nPHYSICS_POINTS = 100\nTEST_POINTS = 500\n\nHIDDEN_LAYERS = 3\nLEARNING_RATE = 0.001\nOPTIMIZER_NAME = \"Adam\"\nACTIVATION = \"Tanh\"\n\nLOSS_FORMULA = \"L_total = L_physics + IC_WEIGHT * L_IC\"\nEQUATION = \"dx/dt = r*x*(1 - x/K)\"\nINITIAL_CONDITION = \"x(0) = 100\"\nREFERENCE_METHOD = \"Python RK4\"\n\n\n# ---------------------------------------------------------------------------\n# Output paths\n# ---------------------------------------------------------------------------\nRESULT_ROOT = Path(\"/kaggle/working/results/logistic_growth_1D\")\n\nMASTER_CSV = RESULT_ROOT / \"complete_experiment_data.csv\"\nSUMMARY_CSV = RESULT_ROOT / \"all_results.csv\"\nCOMBINED_PLOT = RESULT_ROOT / \"all_pinn_vs_rk4.png\"\n\n# True starts a clean run by deleting the contents of RESULT_ROOT.\n# Download previous results before starting a new run if you need to retain them.\nRESET_OUTPUT_DIRECTORY = True\n\nprint(\"\\nPlanned configurations:\")\nfor epochs, neurons, ic_weight in CONFIGS:\n    print(\n        f\"Epochs/window={epochs}, neurons/layer={neurons}, \"\n        f\"IC weight={ic_weight:g}\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T08:39:30.448748Z","iopub.execute_input":"2026-10-13T08:39:30.449324Z","iopub.status.idle":"2026-10-13T08:39:54.812335Z","shell.execute_reply.started":"2026-10-13T08:39:30.449293Z","shell.execute_reply":"2026-10-13T08:39:54.811341Z"}},"outputs":[{"name":"stdout","text":"TensorFlow: 2.20.0\nDetected GPUs: [PhysicalDevice(name='/physical_device:GPU:0', device_type='GPU'), PhysicalDevice(name='/physical_device:GPU:1', device_type='GPU')]\nNote: this script does not distribute training across both T4 GPUs.\n\nPlanned configurations:\nEpochs/window=1000, neurons/layer=50, IC weight=1\nEpochs/window=5000, neurons/layer=100, IC weight=1\nEpochs/window=10000, neurons/layer=150, IC weight=1\nEpochs/window=1000, neurons/layer=50, IC weight=10\nEpochs/window=5000, neurons/layer=100, IC weight=10\nEpochs/window=10000, neurons/layer=150, IC weight=10\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# ============================================================================\n# CELL 2 — CORE EXPERIMENT CODE\n# Defines metadata/data helpers, the PINN, RK4, and the training routine.\n# Run after Cell 1. Plot generation is intentionally deferred to Cell 4.\n# ============================================================================\n\n\n# ---------------------------------------------------------------------------\n# 1. Experiment identifiers and metadata\n# ---------------------------------------------------------------------------\ndef weight_tag(ic_weight):\n    \"\"\"Create a compact, filesystem-safe IC-weight label.\"\"\"\n    return f\"{ic_weight:g}\".replace(\".\", \"p\")\n\n\ndef make_experiment_id(epochs, neurons, ic_weight):\n    return f\"LOG-E{epochs}-N{neurons}-ICW{weight_tag(ic_weight)}\"\n\n\ndef make_folder_name(epochs, neurons, ic_weight):\n    return f\"E{epochs}_N{neurons}_ICW{weight_tag(ic_weight)}\"\n\n\ndef metadata(epochs, neurons, ic_weight, data_type):\n    return {\n        \"experiment_id\": make_experiment_id(\n            epochs, neurons, ic_weight\n        ),\n        \"problem_id\": \"LOGISTIC_1D\",\n        \"dimension\": \"1D\",\n        \"problem_type\": \"Nonlinear ODE\",\n        \"equation\": EQUATION,\n        \"r\": R,\n        \"K\": K,\n        \"initial_condition\": INITIAL_CONDITION,\n        \"initial_x\": INITIAL_X,\n        \"time_horizon\": TOTAL_TIME,\n        \"epochs_per_window\": epochs,\n        \"total_training_steps\": epochs * WINDOWS,\n        \"neurons_per_layer\": neurons,\n        \"input_dimension\": 1,\n        \"output_dimension\": 1,\n        \"hidden_layers\": HIDDEN_LAYERS,\n        \"activation\": ACTIVATION,\n        \"optimizer\": OPTIMIZER_NAME,\n        \"learning_rate\": LEARNING_RATE,\n        \"loss_formula\": LOSS_FORMULA,\n        \"ic_weight\": ic_weight,\n        \"windows\": WINDOWS,\n        \"collocation_points_per_window\": PHYSICS_POINTS,\n        \"test_points\": TEST_POINTS,\n        \"random_seed\": SEED,\n        \"reference_method\": REFERENCE_METHOD,\n        \"data_type\": data_type,\n    }\n\n\n# ---------------------------------------------------------------------------\n# 2. Master CSV: fixed columns for mixed record types\n# ---------------------------------------------------------------------------\nMASTER_COLUMNS = [\n    \"record_type\",\n    \"experiment_id\",\n    \"problem_id\",\n    \"dimension\",\n    \"problem_type\",\n    \"equation\",\n    \"r\",\n    \"K\",\n    \"initial_condition\",\n    \"initial_x\",\n    \"time_horizon\",\n    \"epochs_per_window\",\n    \"total_training_steps\",\n    \"neurons_per_layer\",\n    \"input_dimension\",\n    \"output_dimension\",\n    \"hidden_layers\",\n    \"activation\",\n    \"optimizer\",\n    \"learning_rate\",\n    \"loss_formula\",\n    \"ic_weight\",\n    \"windows\",\n    \"collocation_points_per_window\",\n    \"test_points\",\n    \"random_seed\",\n    \"reference_method\",\n    \"data_type\",\n    # Prediction fields\n    \"time\",\n    \"pinn_x\",\n    \"rk4_x\",\n    \"signed_error\",\n    \"absolute_error\",\n    \"squared_error\",\n    # Training-history fields\n    \"global_step\",\n    \"window\",\n    \"epoch_in_window\",\n    \"window_t_start\",\n    \"window_t_end\",\n    \"physics_loss\",\n    \"ic_loss\",\n    \"weighted_ic_loss\",\n    \"total_loss\",\n    # Experiment-level metrics\n    \"mae\",\n    \"mse\",\n    \"rmse\",\n    \"relative_l2_error\",\n    \"max_absolute_error\",\n    \"selection_metric\",\n]\n\n\ndef append_master_rows(\n    data_df, record_type, epochs, neurons, ic_weight\n):\n    \"\"\"Append records to the master CSV with consistent column ordering.\"\"\"\n    data_df = data_df.copy().reset_index(drop=True)\n\n    meta = metadata(\n        epochs, neurons, ic_weight, record_type\n    )\n    meta_df = pd.DataFrame([meta] * len(data_df))\n\n    combined = pd.concat([meta_df, data_df], axis=1)\n    combined.insert(0, \"record_type\", record_type)\n    combined = combined.reindex(columns=MASTER_COLUMNS)\n\n    combined.to_csv(\n        MASTER_CSV,\n        mode=\"a\",\n        header=not MASTER_CSV.exists(),\n        index=False,\n    )\n\n\ndef attach_file_metadata(\n    data_df, epochs, neurons, ic_weight, data_type\n):\n    \"\"\"Add experiment metadata without creating duplicate column names.\"\"\"\n    data_df = data_df.copy().reset_index(drop=True)\n\n    meta = metadata(\n        epochs, neurons, ic_weight, data_type\n    )\n\n    if data_type == \"MATLAB_RK4_inputs\":\n        meta[\"reference_method\"] = (\n            \"MATLAB RK4 input only; \"\n            \"MATLAB is not executed by this Python script\"\n        )\n\n    # If the data already contains a column such as time, r, K, or initial_x,\n    # keep that value only once instead of creating duplicate column names.\n    for column in data_df.columns:\n        meta.pop(column, None)\n\n    meta_df = pd.DataFrame([meta] * len(data_df))\n    return pd.concat([meta_df, data_df], axis=1)\n\n\ndef save_experiment_csv(\n    data_df,\n    output_path,\n    epochs,\n    neurons,\n    ic_weight,\n    data_type,\n):\n    \"\"\"Write one self-describing CSV inside the experiment folder.\"\"\"\n    output_df = attach_file_metadata(\n        data_df,\n        epochs,\n        neurons,\n        ic_weight,\n        data_type,\n    )\n\n    output_df.to_csv(output_path, index=False)\n\n\ndef write_summary(summary_rows):\n    \"\"\"Save run status and mark the best completed experiments.\"\"\"\n    summary_df = pd.DataFrame(summary_rows)\n\n    if summary_df.empty:\n        summary_df.to_csv(SUMMARY_CSV, index=False)\n        return summary_df\n\n    summary_df[\"best_overall\"] = False\n    summary_df[\"best_within_ic_weight\"] = False\n\n    completed = summary_df[\n        (summary_df[\"status\"] == \"completed\")\n        & summary_df[\"relative_l2_error\"].notna()\n    ]\n\n    if not completed.empty:\n        best_overall_idx = completed[\n            \"relative_l2_error\"\n        ].idxmin()\n\n        summary_df.loc[\n            best_overall_idx, \"best_overall\"\n        ] = True\n\n        for _, group in completed.groupby(\"ic_weight\"):\n            best_idx = group[\"relative_l2_error\"].idxmin()\n            summary_df.loc[\n                best_idx, \"best_within_ic_weight\"\n            ] = True\n\n    summary_df.to_csv(SUMMARY_CSV, index=False)\n    return summary_df\n\n\n# ---------------------------------------------------------------------------\n# 3. Model, logistic ODE, and independent Python RK4 reference\n# ---------------------------------------------------------------------------\ndef build_model(neurons):\n    \"\"\"Build a fully connected PINN with three hidden Tanh layers.\"\"\"\n    layers = [tf.keras.layers.Input(shape=(1,))]\n\n    for _ in range(HIDDEN_LAYERS):\n        layers.append(\n            tf.keras.layers.Dense(\n                neurons,\n                activation=\"tanh\",\n            )\n        )\n\n    layers.append(\n        tf.keras.layers.Dense(1, activation=\"linear\")\n    )\n\n    return tf.keras.Sequential(layers)\n\n\ndef rhs(t, x):\n    \"\"\"Right-hand side of dx/dt = r*x*(1 - x/K).\"\"\"\n    return R * x * (1.0 - x / K)\n\n\ndef physics_residual(model, t):\n    \"\"\"Calculate dx/dt - RHS using automatic differentiation.\"\"\"\n    t = tf.cast(t, tf.float32)\n\n    with tf.GradientTape() as time_tape:\n        time_tape.watch(t)\n        x = model(t, training=True)\n\n    dx_dt = time_tape.gradient(x, t)\n\n    if dx_dt is None:\n        raise RuntimeError(\n            \"Could not calculate dx/dt; check the model and gradient tape.\"\n        )\n\n    return dx_dt - rhs(t, x)\n\n\ndef rk4_solution(t_values):\n    \"\"\"Solve the logistic ODE using classical fixed-grid RK4.\"\"\"\n    t_values = np.asarray(\n        t_values, dtype=np.float64\n    ).flatten()\n\n    if len(t_values) < 2:\n        raise ValueError(\n            \"RK4 requires at least two time points.\"\n        )\n\n    x_values = np.zeros(\n        len(t_values), dtype=np.float64\n    )\n    x_values[0] = INITIAL_X\n\n    def f(_t, x):\n        return R * x * (1.0 - x / K)\n\n    for i in range(len(t_values) - 1):\n        h = t_values[i + 1] - t_values[i]\n        ti = t_values[i]\n        xi = x_values[i]\n\n        k1 = f(ti, xi)\n        k2 = f(ti + h / 2.0, xi + h * k1 / 2.0)\n        k3 = f(ti + h / 2.0, xi + h * k2 / 2.0)\n        k4 = f(ti + h, xi + h * k3)\n\n        x_values[i + 1] = xi + (h / 6.0) * (\n            k1 + 2.0 * k2 + 2.0 * k3 + k4\n        )\n\n    return x_values\n\n\n# ---------------------------------------------------------------------------\n# 4. Train, checkpoint, evaluate, and save one experiment\n# ---------------------------------------------------------------------------\ndef run_experiment(\n    epochs,\n    neurons,\n    ic_weight,\n    progress_state,\n    total_updates,\n):\n    exp_id = make_experiment_id(\n        epochs, neurons, ic_weight\n    )\n\n    exp_root = RESULT_ROOT / make_folder_name(\n        epochs, neurons, ic_weight\n    )\n    exp_root.mkdir(parents=True, exist_ok=True)\n\n    # A fresh model per configuration. The same model is warm-started\n    # across that experiment's five sequential time windows.\n    tf.keras.backend.clear_session()\n    tf.random.set_seed(SEED)\n\n    model = build_model(neurons)\n    optimizer = tf.keras.optimizers.Adam(\n        learning_rate=LEARNING_RATE\n    )\n\n    current_x0 = tf.constant(\n        [[INITIAL_X]], dtype=tf.float32\n    )\n\n    window_edges = np.linspace(\n        0.0, TOTAL_TIME, WINDOWS + 1\n    )\n\n    # These are generated in Cell 3 and are shared by all configurations.\n    t_eval = SHARED_T_EVAL\n    x_rk4 = SHARED_X_RK4.copy()\n\n    x_predictions = np.full(\n        TEST_POINTS, np.nan, dtype=np.float64\n    )\n\n    experiment_start = time.time()\n    experiment_local_step = 0\n\n    print(f\"\\nStarting {exp_id}\")\n\n    # -----------------------------------------------------------------------\n    # Train sequentially through the time windows\n    # -----------------------------------------------------------------------\n    for w in range(WINDOWS):\n        window_number = w + 1\n        t_start = float(window_edges[w])\n        t_end = float(window_edges[w + 1])\n\n        t_physics = tf.reshape(\n            tf.linspace(\n                t_start, t_end, PHYSICS_POINTS\n            ),\n            (-1, 1),\n        )\n        t_physics = tf.cast(t_physics, tf.float32)\n\n        t_init = tf.constant(\n            [[t_start]], dtype=tf.float32\n        )\n\n        current_window_history = []\n\n        for ep in range(1, epochs + 1):\n            with tf.GradientTape() as parameter_tape:\n                residual = physics_residual(\n                    model, t_physics\n                )\n\n                physics_loss = tf.reduce_mean(\n                    tf.square(residual)\n                )\n\n                x_init_pred = model(\n                    t_init, training=True\n                )\n\n                ic_loss = tf.reduce_mean(\n                    tf.square(x_init_pred - current_x0)\n                )\n\n                total_loss = (\n                    physics_loss + ic_weight * ic_loss\n                )\n\n            gradients = parameter_tape.gradient(\n                total_loss,\n                model.trainable_variables,\n            )\n\n            if any(g is None for g in gradients):\n                raise RuntimeError(\n                    f\"A trainable variable has no gradient in {exp_id}.\"\n                )\n\n            optimizer.apply_gradients(\n                zip(gradients, model.trainable_variables)\n            )\n\n            experiment_local_step += 1\n            progress_state[\"updates_done\"] += 1\n\n            loss_row = [\n                experiment_local_step,\n                window_number,\n                ep,\n                float(physics_loss.numpy()),\n                float(ic_loss.numpy()),\n                float(total_loss.numpy()),\n            ]\n            current_window_history.append(loss_row)\n\n            # Update one progress line every 100 epochs and at each\n            # window's last epoch.\n            if ep % 100 == 0 or ep == epochs:\n                percent = (\n                    100.0\n                    * progress_state[\"updates_done\"]\n                    / total_updates\n                )\n\n                status = (\n                    f\"Overall {percent:6.2f}% \"\n                    f\"({progress_state['updates_done']:,}/\"\n                    f\"{total_updates:,} updates) | {exp_id} | \"\n                    f\"window {window_number}/{WINDOWS} | \"\n                    f\"epoch {ep:,}/{epochs:,} | \"\n                    f\"total loss={float(total_loss.numpy()):.5e}\"\n                )\n\n                try:\n                    progress_state[\"display_handle\"].update(\n                        status\n                    )\n                except Exception:\n                    print(status, flush=True)\n\n        # -------------------------------------------------------------------\n        # Checkpoint this window's training losses to the master CSV\n        # and the experiment folder's epoch_loss.csv.\n        # -------------------------------------------------------------------\n        window_loss_df = pd.DataFrame(\n            current_window_history,\n            columns=[\n                \"global_step\",\n                \"window\",\n                \"epoch_in_window\",\n                \"physics_loss\",\n                \"ic_loss\",\n                \"total_loss\",\n            ],\n        )\n\n        window_loss_df[\"weighted_ic_loss\"] = (\n            ic_weight * window_loss_df[\"ic_loss\"]\n        )\n        window_loss_df[\"window_t_start\"] = t_start\n        window_loss_df[\"window_t_end\"] = t_end\n\n        append_master_rows(\n            window_loss_df,\n            \"training_loss\",\n            epochs,\n            neurons,\n            ic_weight,\n        )\n\n        local_loss_path = exp_root / \"epoch_loss.csv\"\n        local_loss_with_metadata = attach_file_metadata(\n            window_loss_df,\n            epochs,\n            neurons,\n            ic_weight,\n            \"Training_loss_history\",\n        )\n\n        local_loss_with_metadata.to_csv(\n            local_loss_path,\n            mode=\"a\" if local_loss_path.exists() else \"w\",\n            header=not local_loss_path.exists(),\n            index=False,\n        )\n\n        # -------------------------------------------------------------------\n        # Evaluate predictions in this window.\n        # Adjacent windows do not duplicate their boundary points.\n        # -------------------------------------------------------------------\n        if w < WINDOWS - 1:\n            mask = (\n                (t_eval >= t_start)\n                & (t_eval < t_end)\n            )\n        else:\n            mask = (\n                (t_eval >= t_start)\n                & (t_eval <= t_end)\n            )\n\n        t_window = t_eval[mask]\n\n        x_window = model(\n            tf.convert_to_tensor(\n                t_window.reshape(-1, 1),\n                dtype=tf.float32,\n            ),\n            training=False,\n        ).numpy().flatten()\n\n        x_predictions[mask] = x_window\n\n        # Warm-start the next time window from the current predicted state.\n        t_boundary = tf.constant(\n            [[t_end]], dtype=tf.float32\n        )\n        current_x0 = tf.stop_gradient(\n            model(t_boundary, training=False)\n        )\n\n    if np.isnan(x_predictions).any():\n        raise RuntimeError(\n            f\"Some test points have no PINN predictions in {exp_id}.\"\n        )\n\n    # -----------------------------------------------------------------------\n    # Evaluation metrics against the Python RK4 reference\n    # -----------------------------------------------------------------------\n    error = x_predictions - x_rk4\n    abs_error = np.abs(error)\n\n    mse = float(np.mean(np.square(error)))\n    rmse = float(np.sqrt(mse))\n    mae = float(np.mean(abs_error))\n\n    relative_l2 = float(\n        np.linalg.norm(error)\n        / np.linalg.norm(x_rk4)\n    )\n\n    max_error = float(np.max(abs_error))\n    duration_seconds = float(\n        time.time() - experiment_start\n    )\n\n    # -----------------------------------------------------------------------\n    # Save PINN predictions to this experiment's folder\n    # -----------------------------------------------------------------------\n    pinn_df = pd.DataFrame({\n        \"time\": t_eval,\n        \"pinn_x\": x_predictions,\n    })\n\n    save_experiment_csv(\n        pinn_df,\n        exp_root / \"pinn_output.csv\",\n        epochs,\n        neurons,\n        ic_weight,\n        \"PINN_predictions\",\n    )\n\n    # -----------------------------------------------------------------------\n    # Save inputs for an independent MATLAB RK4 implementation\n    # -----------------------------------------------------------------------\n    matlab_input_df = pd.DataFrame({\n        \"time\": t_eval,\n        \"time_step\": np.r_[\n            np.diff(t_eval),\n            np.diff(t_eval)[-1],\n        ],\n        \"initial_x\": np.full(\n            TEST_POINTS, INITIAL_X, dtype=np.float64\n        ),\n        \"r\": np.full(\n            TEST_POINTS, R, dtype=np.float64\n        ),\n        \"K\": np.full(\n            TEST_POINTS, K, dtype=np.float64\n        ),\n    })\n\n    save_experiment_csv(\n        matlab_input_df,\n        exp_root / \"matlab_input.csv\",\n        epochs,\n        neurons,\n        ic_weight,\n        \"MATLAB_RK4_inputs\",\n    )\n\n    # -----------------------------------------------------------------------\n    # Save the corresponding Python RK4 reference in this run's folder\n    # -----------------------------------------------------------------------\n    rk4_df = pd.DataFrame({\n        \"time\": t_eval,\n        \"rk4_x\": x_rk4,\n    })\n\n    save_experiment_csv(\n        rk4_df,\n        exp_root / \"rk4_reference.csv\",\n        epochs,\n        neurons,\n        ic_weight,\n        \"Python_RK4_reference\",\n    )\n\n    # -----------------------------------------------------------------------\n    # Save final evaluation metrics in metrics.csv\n    # -----------------------------------------------------------------------\n    metrics_df = pd.DataFrame([{\n        \"mae\": mae,\n        \"mse\": mse,\n        \"rmse\": rmse,\n        \"relative_l2_error\": relative_l2,\n        \"max_absolute_error\": max_error,\n        \"selection_metric\": (\n            \"relative_l2_error_vs_Python_RK4\"\n        ),\n        \"reference_method\": REFERENCE_METHOD,\n        \"prediction_points\": len(t_eval),\n        \"duration_seconds\": duration_seconds,\n    }])\n\n    save_experiment_csv(\n        metrics_df,\n        exp_root / \"metrics.csv\",\n        epochs,\n        neurons,\n        ic_weight,\n        \"PINN_RK4_metrics\",\n    )\n\n    # -----------------------------------------------------------------------\n    # Append pointwise predictions, reference, and errors to the master CSV\n    # -----------------------------------------------------------------------\n    prediction_df = pd.DataFrame({\n        \"time\": t_eval,\n        \"pinn_x\": x_predictions,\n        \"rk4_x\": x_rk4,\n        \"signed_error\": error,\n        \"absolute_error\": abs_error,\n        \"squared_error\": np.square(error),\n    })\n\n    append_master_rows(\n        prediction_df,\n        \"prediction\",\n        epochs,\n        neurons,\n        ic_weight,\n    )\n\n    # Append one experiment-level metrics record to the master CSV.\n    metric_df = pd.DataFrame([{\n        \"mae\": mae,\n        \"mse\": mse,\n        \"rmse\": rmse,\n        \"relative_l2_error\": relative_l2,\n        \"max_absolute_error\": max_error,\n        \"selection_metric\": (\n            \"relative_l2_error_vs_Python_RK4\"\n        ),\n    }])\n\n    append_master_rows(\n        metric_df,\n        \"experiment_metrics\",\n        epochs,\n        neurons,\n        ic_weight,\n    )\n\n    # -----------------------------------------------------------------------\n    # Result record for all_results.csv\n    # -----------------------------------------------------------------------\n    result = metadata(\n        epochs,\n        neurons,\n        ic_weight,\n        \"experiment_summary\",\n    )\n\n    result.update({\n        \"status\": \"completed\",\n        \"error_message\": \"\",\n        \"duration_seconds\": duration_seconds,\n        \"mae\": mae,\n        \"mse\": mse,\n        \"rmse\": rmse,\n        \"relative_l2_error\": relative_l2,\n        \"max_absolute_error\": max_error,\n        \"selection_metric\": (\n            \"relative_l2_error_vs_Python_RK4\"\n        ),\n        \"experiment_folder\": str(exp_root),\n        \"solution_plot\": str(\n            exp_root / \"pinn_vs_rk4.png\"\n        ),\n        \"loss_plot\": str(\n            exp_root / \"epochs_vs_loss.png\"\n        ),\n    })\n\n    print(\n        f\"Completed {exp_id} in \"\n        f\"{duration_seconds / 60.