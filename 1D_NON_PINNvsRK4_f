{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.6.6","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import random,numpy as np,pandas as pd,tensorflow as tf,matplotlib.pyplot as plt\nfrom pathlib import Path\nfrom IPython.display import display,Image\n\n# Set reproducibility\nSEED=42\nnp.random.seed(SEED)\nrandom.seed(SEED)\ntf.random.set_seed(SEED)\n\n# Define the experiment configurations\nEPOCHS=[1000,5000,10000]\nNEURONS=[50,100,150]\nCONFIGS=list(zip(EPOCHS,NEURONS))\n\n# Define the fixed PINN settings\nR=0.8\nK=1000.0\nINITIAL_X=100.0\nTOTAL_TIME=1.0\nWINDOWS=5\nPHYSICS_POINTS=100\nTEST_POINTS=500\nHIDDEN_LAYERS=3\nLEARNING_RATE=0.001\nIC_WEIGHT=1.0\nOPTIMIZER_NAME=\"Adam\"\nACTIVATION=\"Tanh\"\nLOSS_FORMULA=\"L_physics + L_IC\"\nEQUATION=\"dx/dt = r*x*(1-x/K)\"\nINITIAL_CONDITION=\"x(0)=100\"\nRESULT_ROOT=Path(\"/kaggle/working/results/logistic_growth_1D\")\n\n# Build the PINN with three hidden Tanh layers\ndef build_model(neurons):\n    layers=[tf.keras.layers.Input(shape=(1,))]\n    for _ in range(HIDDEN_LAYERS):\n        layers.append(tf.keras.layers.Dense(neurons,activation=\"tanh\"))\n    layers.append(tf.keras.layers.Dense(1,activation=\"linear\"))\n    return tf.keras.Sequential(layers)\n\n# Define the logistic-growth equation\ndef rhs(t,x):\n    return R*x*(1.0-x/K)\n\n# Calculate the physics residual using automatic differentiation\ndef physics_residual(model,t):\n    t=tf.cast(t,tf.float32)\n    with tf.GradientTape() as tape:\n        tape.watch(t)\n        x=model(t,training=True)\n    dx_dt=tape.gradient(x,t)\n    return dx_dt-rhs(t,x)\n\n# Solve the logistic equation independently using RK4\ndef rk4_solution(t):\n    t=np.asarray(t,dtype=np.float64).flatten()\n    x=np.zeros(len(t),dtype=np.float64)\n    x[0]=INITIAL_X\n\n    def f(tv,xv):\n        return R*xv*(1.0-xv/K)\n\n    for i in range(len(t)-1):\n        h=t[i+1]-t[i]\n        ti=t[i]\n        xi=x[i]\n        k1=f(ti,xi)\n        k2=f(ti+h/2,xi+h*k1/2)\n        k3=f(ti+h/2,xi+h*k2/2)\n        k4=f(ti+h,xi+h*k3)\n        x[i+1]=xi+(h/6)*(k1+2*k2+2*k3+k4)\n\n    return x\n\n# Create consistent metadata for every CSV\ndef metadata(epochs,neurons,data_type):\n    return {\n        \"experiment_id\":f\"LOG-E{epochs}-N{neurons}\",\n        \"problem_id\":\"LOGISTIC_1D\",\n        \"dimension\":\"1D\",\n        \"problem_type\":\"Nonlinear\",\n        \"equation\":EQUATION,\n        \"r\":R,\n        \"K\":K,\n        \"initial_condition\":INITIAL_CONDITION,\n        \"initial_x\":INITIAL_X,\n        \"time_horizon\":TOTAL_TIME,\n        \"epochs_per_window\":epochs,\n        \"total_training_steps\":epochs*WINDOWS,\n        \"neurons_per_layer\":neurons,\n        \"input_dimension\":1,\n        \"output_dimension\":1,\n        \"hidden_layers\":HIDDEN_LAYERS,\n        \"activation\":ACTIVATION,\n        \"optimizer\":OPTIMIZER_NAME,\n        \"learning_rate\":LEARNING_RATE,\n        \"loss_formula\":LOSS_FORMULA,\n        \"ic_weight\":IC_WEIGHT,\n        \"windows\":WINDOWS,\n        \"collocation_points_per_window\":PHYSICS_POINTS,\n        \"test_points\":TEST_POINTS,\n        \"random_seed\":SEED,\n        \"data_type\":data_type\n    }\n\n# Add metadata to a data table\ndef add_metadata(df,epochs,neurons,data_type):\n    meta=metadata(epochs,neurons,data_type)\n    return pd.concat([pd.DataFrame([meta]*len(df)),df.reset_index(drop=True)],axis=1)\n\n# Run one complete PINN experiment\ndef run_experiment(epochs,neurons):\n    exp_id=f\"LOG-E{epochs}-N{neurons}\"\n    exp_root=RESULT_ROOT/f\"E{epochs}_N{neurons}\"\n    exp_root.mkdir(parents=True,exist_ok=True)\n\n    # Create a new model for this configuration\n    tf.keras.backend.clear_session()\n    tf.random.set_seed(SEED)\n    model=build_model(neurons)\n    optimizer=tf.keras.optimizers.Adam(learning_rate=LEARNING_RATE)\n\n    # Set the initial condition for the first window\n    current_x0=tf.constant([[INITIAL_X]],dtype=tf.float32)\n    loss_history=[]\n    t_eval=np.linspace(0.0,TOTAL_TIME,TEST_POINTS,dtype=np.float64)\n    x_predictions=np.full(TEST_POINTS,np.nan,dtype=np.float64)\n    window_edges=np.linspace(0.0,TOTAL_TIME,WINDOWS+1)\n    global_step=0\n\n    # Train the model across sequential time windows\n    for w in range(WINDOWS):\n        t_start=float(window_edges[w])\n        t_end=float(window_edges[w+1])\n\n        # Generate collocation points for the current window\n        t_physics=tf.cast(\n            tf.reshape(tf.linspace(t_start,t_end,PHYSICS_POINTS),(-1,1)),\n            tf.float32\n        )\n\n        # Define the initial point of the current window\n        t_init=tf.constant([[t_start]],dtype=tf.float32)\n\n        # Train the PINN over the current time window\n        for ep in range(epochs):\n            with tf.GradientTape() as tape:\n                physics_res=physics_residual(model,t_physics)\n                physics_loss=tf.reduce_mean(tf.square(physics_res))\n\n                # Calculate the initial-condition loss\n                x_init_pred=model(t_init,training=True)\n                ic_loss=tf.reduce_mean(tf.square(x_init_pred-current_x0))\n\n                # Combine physics and initial-condition losses\n                loss=physics_loss+IC_WEIGHT*ic_loss\n\n            gradients=tape.gradient(loss,model.trainable_variables)\n            optimizer.apply_gradients(zip(gradients,model.trainable_variables))\n\n            # Record the loss at every optimizer update\n            global_step+=1\n            loss_history.append([\n                global_step,w+1,ep+1,\n                float(physics_loss.numpy()),\n                float(ic_loss.numpy()),\n                float(loss.numpy())\n            ])\n\n        # Evaluate the trained model at test points in this window\n        if w<WINDOWS-1:\n            mask=(t_eval>=t_start)&(t_eval<t_end)\n        else:\n            mask=(t_eval>=t_start)&(t_eval<=t_end)\n\n        t_window=t_eval[mask]\n        t_tensor=tf.convert_to_tensor(t_window.reshape(-1,1),dtype=tf.float32)\n        x_window=model(t_tensor,training=False).numpy().flatten()\n        x_predictions[mask]=x_window\n\n        # Use the predicted boundary state as the next window's initial condition\n        t_boundary=tf.constant([[t_end]],dtype=tf.float32)\n        current_x0=model(t_boundary,training=False)\n\n    # Verify that all requested test points have predictions\n    if np.isnan(x_predictions).any():\n        raise RuntimeError(\"Some test points have no PINN predictions.\")\n\n    # Calculate the independent RK4 reference solution\n    x_rk4=rk4_solution(t_eval)\n\n    # Calculate PINN versus RK4 error metrics\n    error=x_predictions-x_rk4\n    mse=float(np.mean(error**2))\n    rmse=float(np.sqrt(mse))\n    mae=float(np.mean(np.abs(error)))\n    relative_l2=float(np.linalg.norm(error)/np.linalg.norm(x_rk4))\n    max_error=float(np.max(np.abs(error)))\n\n    # Save the PINN predictions separately\n    pinn_df=add_metadata(\n        pd.DataFrame({\"time\":t_eval,\"pinn_x\":x_predictions}),\n        epochs,neurons,\"PINN_predictions\"\n    )\n    pinn_df.to_csv(exp_root/\"pinn_output.csv\",index=False)\n\n    # Save the inputs required for MATLAB RK4\n    matlab_df=add_metadata(\n        pd.DataFrame({\n            \"time\":t_eval,\n            \"initial_x\":INITIAL_X,\n            \"r\":R,\n            \"K\":K\n        }),\n        epochs,neurons,\"MATLAB_RK4_inputs\"\n    )\n    matlab_df.to_csv(exp_root/\"matlab_input.csv\",index=False)\n\n    # Save the Python RK4 reference separately\n    rk4_df=add_metadata(\n        pd.DataFrame({\"time\":t_eval,\"rk4_x\":x_rk4}),\n        epochs,neurons,\"Python_RK4_reference\"\n    )\n    rk4_df.to_csv(exp_root/\"rk4_reference.csv\",index=False)\n\n    # Save the complete training-loss history\n    loss_array=np.asarray(loss_history,dtype=np.float64)\n    loss_df=add_metadata(\n        pd.DataFrame({\n            \"global_step\":loss_array[:,0].astype(int),\n            \"window\":loss_array[:,1].astype(int),\n            \"epoch\":loss_array[:,2].astype(int),\n            \"physics_loss\":loss_array[:,3],\n            \"ic_loss\":loss_array[:,4],\n            \"total_loss\":loss_array[:,5]\n        }),\n        epochs,neurons,\"Training_loss_history\"\n    )\n    loss_df.to_csv(exp_root/\"epoch_loss.csv\",index=False)\n\n    # Save the comparison metrics\n    metrics={\n        \"mae\":mae,\n        \"rmse\":rmse,\n        \"mse\":mse,\n        \"relative_l2_error\":relative_l2,\n        \"max_absolute_error\":max_error,\n        \"selection_metric\":\"relative_l2_error\",\n        \"reference_method\":\"Python RK4\"\n    }\n    metrics_df=add_metadata(\n        pd.DataFrame([metrics]),epochs,neurons,\"PINN_RK4_metrics\"\n    )\n    metrics_df.to_csv(exp_root/\"metrics.csv\",index=False)\n\n    # Create a shared, self-identifying plot heading\n    heading=(\n        f\"{exp_id} | Nonlinear Logistic-Growth ODE\\n\"\n        f\"{EQUATION}\\n\"\n        f\"x(0)={INITIAL_X} | r={R} | K={K} | \"\n        f\"Epochs/window={epochs} | Neurons/layer={neurons}\"\n    )\n    footer=(\n        f\"Architecture: 1-{neurons}x{HIDDEN_LAYERS}-1 | \"\n        f\"Activation: {ACTIVATION} | Optimizer: {OPTIMIZER_NAME} | \"\n        f\"LR={LEARNING_RATE}\\n\"\n        f\"Loss: L = L_physics + L_IC | IC weight={IC_WEIGHT} | \"\n        f\"T={TOTAL_TIME} | Windows={WINDOWS} | \"\n        f\"Collocation points/window={PHYSICS_POINTS} | \"\n        f\"Test points={TEST_POINTS} | Seed={SEED}\"\n    )\n\n    # Plot PINN predictions against RK4\n    fig,ax=plt.subplots(figsize=(12,7))\n    ax.plot(t_eval,x_rk4,label=\"RK4 reference\",linewidth=2)\n    ax.plot(t_eval,x_predictions,\"--\",label=\"PINN prediction\",linewidth=2)\n    ax.set_xlabel(\"Time, t\")\n    ax.set_ylabel(\"Population, x(t)\")\n    ax.set_title(heading,fontsize=11,pad=14)\n    ax.grid(True)\n    ax.legend()\n    fig.text(0.5,0.015,footer,ha=\"center\",va=\"bottom\",fontsize=8,wrap=True)\n    fig.tight_layout(rect=[0,0.105,1,0.88])\n    fig.savefig(exp_root/\"pinn_vs_rk4.png\",dpi=300,bbox_inches=\"tight\")\n    plt.close(fig)\n\n    # Plot total loss against cumulative training steps\n    loss_values=np.maximum(loss_array[:,5],np.finfo(float).tiny)\n    fig,ax=plt.subplots(figsize=(12,7))\n    ax.plot(loss_array[:,0],loss_values,linewidth=1)\n    ax.set_yscale(\"log\")\n    ax.set_xlabel(\"Cumulative Training Step\")\n    ax.set_ylabel(\"Total Loss\")\n    ax.set_title(heading+\"\\nTraining Loss\",fontsize=11,pad=14)\n    ax.grid(True)\n    fig.text(0.5,0.015,footer,ha=\"center\",va=\"bottom\",fontsize=8,wrap=True)\n    fig.tight_layout(rect=[0,0.105,1,0.88])\n    fig.savefig(exp_root/\"epoch_loss.png\",dpi=300,bbox_inches=\"tight\")\n    plt.close(fig)\n\n    # Return the experiment configuration and its metrics\n    result=metadata(epochs,neurons,\"Experiment_summary\")\n    result.update(metrics)\n    result[\"experiment_folder\"]=str(exp_root)\n    return result\n\n# Create the output directory\nRESULT_ROOT.mkdir(parents=True,exist_ok=True)\n\n# Run all logistic-growth configurations\nall_results=[]\nfor epochs,neurons in CONFIGS:\n    print(f\"Running LOG-E{epochs}-N{neurons}\")\n    all_results.append(run_experiment(epochs,neurons))\n\n# Save the complete experiment summary\nresults_df=pd.DataFrame(all_results)\nresults_df.to_csv(RESULT_ROOT/\"all_results.csv\",index=False)\n\n# Select the best configuration by relative L2 error against RK4\nbest_index=results_df[\"relative_l2_error\"].idxmin()\nbest_result=results_df.loc[[best_index]].copy()\nbest_result[\"selection_rule\"]=\"Minimum relative L2 error against Python RK4\"\nbest_result[\"interpretation\"]=\"Best among tested configurations; not an exact-solution error\"\nbest_result.to_csv(RESULT_ROOT/\"best_result.csv\",index=False)\n\n# Display the experiment summary and best result\nprint(\"\\nAll experiment results:\")\ndisplay(results_df)\n\nprint(\"\\nBest configuration by relative L2 error:\")\ndisplay(best_result)\n\nprint(f\"\\nCompleted {len(all_results)} experiments.\")\nprint(f\"Results saved to: {RESULT_ROOT}\")\n\n# Display all generated plots\nprint(\"\\nDisplaying generated plots...\")\nfor epochs,neurons in CONFIGS:\n    exp_root=RESULT_ROOT/f\"E{epochs}_N{neurons}\"\n    print(f\"\\nLOG-E{epochs}-N{neurons}\")\n    display(Image(filename=str(exp_root/\"pinn_vs_rk4.png\")))\n    display(Image(filename=str(exp_root/\"epoch_loss.png\")))","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null}]}