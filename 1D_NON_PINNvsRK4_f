IZER_NAME,\n        \"learning_rate\": LEARNING_RATE,\n        \"ic_weight\": ic_weight,\n        \"loss_formula\": \"L_physics + ic_weight * L_IC\",\n        \"windows\": WINDOWS,\n        \"collocation_points_per_window\": PHYSICS_POINTS,\n        \"random_seed\": SEED,\n        \"reference_method_for_metrics\": REFERENCE_METHOD,\n    }\n\n\ndef write_summary(summary_rows):\n    df = pd.DataFrame(summary_rows)\n    df[\"best_overall\"] = False\n    df[\"best_within_ic_weight\"] = False\n\n    completed = df[\n        (df[\"status\"] == \"completed\")\n        & df[\"Relative_L2_error\"].notna()\n    ]\n\n    if not completed.empty:\n        best_idx = completed[\"Relative_L2_error\"].idxmin()\n        df.loc[best_idx, \"best_overall\"] = True\n\n        for _, group in completed.groupby(\"ic_weight\"):\n            idx = group[\"Relative_L2_error\"].idxmin()\n            df.loc[idx, \"best_within_ic_weight\"] = True\n\n    df.to_csv(RESULT_ROOT / \"all_results.csv\", index=False)\n    return df\n\n\ndef export_matlab_files(completed_outputs):\n    \"\"\"\n    matlab_reference.csv:\n        t + PINN outputs from each configuration only.\n\n    matlab_parameters.csv:\n        Fixed ODE inputs are stored once in a separate one-row file.\n    \"\"\"\n    matlab_ref = pd.DataFrame({\"t\": SHARED_T_EVAL})\n\n    all_predictions = pd.DataFrame({\n        \"t\": SHARED_T_EVAL,\n        \"RK4_x\": SHARED_X_RK4,\n    })\n\n    for epochs, neurons, ic_weight in CONFIGS:\n        exp_id = make_experiment_id(\n            epochs, neurons, ic_weight\n        )\n\n        pinn_col = f\"PINN_{exp_id}\"\n        diff_col = f\"PINN_minus_RK4_{exp_id}\"\n        abs_col = f\"Absolute_difference_{exp_id}\"\n        sq_col = f\"Squared_difference_{exp_id}\"\n\n        if exp_id in completed_outputs:\n            pinn = completed_outputs[exp_id][\"pinn\"]\n            err = pinn - SHARED_X_RK4\n\n            matlab_ref[pinn_col] = pinn\n            all_predictions[pinn_col] = pinn\n   