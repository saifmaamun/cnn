n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nRoot-level files:\n/kaggle/working/results/logistic_growth_1D/all_results.csv\n/kaggle/working/results/logistic_growth_1D/all_epoch_losses.csv\n/kaggle/working/results/logistic_growth_1D/all_predictions.csv\n/kaggle/working/results/logistic_growth_1D/matlab_parameters.csv\n/kaggle/working/results/logistic_growth_1D/matlab_reference.csv\n/kaggle/working/results/logistic_growth_1D/rk4_reference.csv\n/kaggle/working/results/logistic_growth_1D/best_result.csv\n/kaggle/working/results/logistic_growth_1D/best_by_ic_weight.csv\n/kaggle/working/results/logistic_growth_1D/all_pinn_vs_rk4.png\n\nRun Cell 4 to generate all plots.\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# ============================================================================\n# CELL 4 — GENERATE ALL INDIVIDUAL AND COMBINED PLOTS\n# This cell can be rerun without retraining.\n# ============================================================================\n\ndef plot_individual_results(\n    results_df, epochs, neurons, ic_weight, output_path\n):\n    exp_id = make_experiment_id(\n        epochs, neurons, ic_weight\n    )\n\n    t = results_df[\"t\"].to_numpy(dtype=float)\n    pinn = results_df[\"PINN_x\"].to_numpy(dtype=float)\n    rk4 = results_df[\"RK4_x\"].to_numpy(dtype=float)\n    err = results_df[\"PINN_minus_RK4_x\"].to_numpy(dtype=float)\n\n    fig, axes = plt.subplots(\n        2, 1,\n        figsize=(11, 8),\n        sharex=True,\n        gridspec_kw={\"height_ratios\": [2, 1]},\n    )\n\n    axes[0].plot(\n        t, rk4,\n        color=\"#222222\",\n        linewidth=2.0,\n        linestyle=\"--\",\n        label=\"Python RK4 reference\",\n        zorder=1,\n    )\n    axes[0].plot(\n        t, pinn,\n        color=\"#0072B2\",\n        linewidth=1.8,\n        label=\"PINN prediction\",\n        zorder=3,\n    )\n\n    axes[0].set_ylabel(\"State x(t)\")\n    axes[0].set_title(\n        f\"{exp_id}\\n\"\n        f\"{EQUATION}; x(0)={INITIAL_X}, r={R}, K={K}\"\n    )\n    axes[0].grid(True, alpha=0.3)\n    axes[0].legend()\n\n    axes[1].plot(\n        t, np.maximum(np.abs(err), 1e-12),\n        color=\"#D55E00\",\n        linewidth=1.5,\n        label=\"Absolute error\",\n    )\n    axes[1].set_yscale(\"log\")\n    axes[1].set_xlabel(\"Time, t\")\n    axes[1].set_ylabel(\"Absolute error (log scale)\")\n    axes[1].grid(True, which=\"both\", alpha=0.25)\n    axes[1].legend()\n\n    fig.tight_layout()\n    fig.savefig(output_path, dpi=220, bbox_inches=\"tight\")\n    return fig\n\n\ndef plot_local_epoch_losses(\n    loss_df, epochs, neurons, ic_weight, output_path\n):\n    exp_id = make_experiment_id(\n        epochs, neurons, ic_weight\n    )\n\n    fig, axes = plt.subplots(\n        WINDOWS, 1,\n        figsize=(12, max(12, 2.6 * WINDOWS)),\n        sharex=True,\n    )\n    axes = np.atleast_1d(axes)\n    edges = np.linspace(0.0, TOTAL_TIME, WINDOWS + 1)\n    tiny = np.finfo(float).tiny\n\n    for window, ax in enumerate(axes, start=1):\n        part = loss_df[\n            loss_df[\"window\"] == window\n        ].sort_values(\"epoch\")\n\n        if part.empty:\n            ax.set_title(f\"Window {window}: no recorded losses\")\n            continue\n\n        x = part[\"epoch\"].to_numpy()\n\n        ax.plot(\n            x,\n            np.maximum(part[\"total_loss\"].to_numpy(), tiny),\n            color=\"#0072B2\",\n            linewidth=1.4,\n            label=\"Total loss\",\n        )\n        ax.plot(\n            x,\n            np.maximum(part[\"physics_loss\"].to_numpy(), tiny),\n            color=\"#D55E00\",\n            linestyle=\"--\",\n            linewidth=1.2,\n            label=\"Physics loss\",\n        )\n        ax.plot(\n            x,\n            np.maximum(part[\"weighted_ic_loss\"].to_numpy(), tiny),\n            color=\"#009E73\",\n            linestyle=\"-.\",\n            linewidth=1.2,\n            label=\"Weighted IC contribution\",\n        )\n\n        ax.set_title(\n            f\"Window {window}: \"\n            f\"t={edges[window-1]:.2f} to {edges[window]:.2f}\",\n            loc=\"left\",\n            fontsize=10,\n        )\n        ax.set_yscale(\"log\")\n        ax.set_xlim(1, epochs)\n        ax.set_ylabel(\"Loss (log scale)\")\n        ax.grid(True, which=\"both\", alpha=0.25)\n        ax.legend(fontsize=8, ncol=3, loc=\"best\")\n\n    axes[-1].set_xlabel(\"Epoch within the current window\")\n\n    fig.suptitle(\n        f\"{exp_id} | Training loss vs local epoch\",\n        y=1.002,\n        fontsize=13,\n    )\n    fig.tight_layout()\n    fig.savefig(output_path, dpi=220, bbox_inches=\"tight\")\n    return fig\n\n\ndef plot_all_pinns(completed_runs, output_path):\n    if not completed_runs:\n        print(\"No completed experiments were available to plot.\")\n        return None\n\n    # Six high-contrast colors plus distinct markers and line styles.\n    colors = [\n        \"#0072B2\", \"#E69F00\", \"#009E73\",\n        \"#CC79A7\", \"#D55E00\", \"#56B4E9\",\n    ]\n    markers = [\"o\", \"s\", \"^\", \"D\", \"v\", \"P\"]\n    linestyles = [\n        \"-\", \"--\", \"-.\", \":\",\n        (0, (5, 1)),\n        (0, (3, 1, 1, 1)),\n    ]\n\n    t = completed_runs[0][\"t\"]\n    rk4 = completed_runs[0][\"rk4\"]\n\n    fig, axes = plt.subplots(\n        2, 1,\n        figsize=(14, 10),\n        sharex=True,\n        gridspec_kw={\"height_ratios\": [2, 1.25]},\n    )\n\n    # RK4 behind the PINN curves: this fixes the previous z-order bug.\n    axes[0].plot(\n        t, rk4,\n        color=\"#222222\",\n        linewidth=2.0,\n        linestyle=(0, (7, 3)),\n        label=\"Python RK4 reference\",\n        zorder=1,\n    )\n\n    maximum_error = max(\n        float(np.max(np.abs(run[\"error\"])))\n        for run in completed_runs\n    )\n    error_floor = max(1e-12, maximum_error * 1e-10)\n\n    for idx, run in enumerate(completed_runs):\n        color = colors[idx % len(colors)]\n        marker_indices = list(\n            range(idx * 7, len(run[\"t\"]), 55)\n        )\n        label = run[\"experiment_id\"]\n\n        axes[0].plot(\n            run[\"t\"],\n            run[\"pinn\"],\n            color=color,\n            linewidth=1.7,\n            linestyle=linestyles[idx % len(linestyles)],\n            marker=markers[idx % len(markers)],\n            markevery=marker_indices,\n            markersize=4.0,\n            markerfacecolor=\"white\",\n            markeredgewidth=1.0,\n            alpha=0.95,\n            label=label,\n            zorder=3 + idx * 0.1,\n        )\n\n        axes[1].plot(\n            run[\"t\"],\n            np.maximum(\n                np.abs(run[\"error\"]), error_floor\n            ),\n            color=color,\n            linewidth=1.6,\n            linestyle=linestyles[idx % len(linestyles)],\n            marker=markers[idx % len(markers)],\n            markevery=marker_indices,\n            markersize=3.5,\n            markerfacecolor=\"white\",\n            markeredgewidth=0.9,\n            label=label,\n            zorder=3 + idx * 0.1,\n        )\n\n    axes[0].set_ylabel(\"State x(t)\")\n    axes[0].set_title(\n        \"All completed PINN configurations vs Python RK4\"\n    )\n    axes[0].grid(True, alpha=0.3)\n    axes[0].legend(fontsize=8, ncol=2)\n\n    # Log scale makes both small and large errors visible together.\n    axes[1].set_yscale(\"log\")\n    axes[1].set_xlabel(\"Time, t\")\n    axes[1].set_ylabel(\"Absolute error (log scale)\")\n    axes[1].grid(True, which=\"both\", alpha=0.25)\n    axes[1].legend(fontsize=8, ncol=2)\n\n    fig.tight_layout()\n    fig.savefig(output_path, dpi=240, bbox_inches=\"tight\")\n    return fig\n\n\nsummary_path = RESULT_ROOT / \"all_results.csv\"\n\nif not summary_path.exists():\n    raise FileNotFoundError(\n        \"Run Cell 3 before running Cell 4.\"\n    )\n\nsummary_df = pd.read_csv(summary_path)\ncompleted_runs_for_plot = []\n\nfor _, row in summary_df.iterrows():\n    if row[\"status\"] != \"completed\":\n        continue\n\n    epochs = int(row[\"epochs_per_window\"])\n    neurons = int(row[\"neurons_per_layer\"])\n    ic_weight = float(row[\"ic_weight\"])\n    exp_root = Path(row[\"experiment_folder\"])\n\n    results_path = exp_root / \"results.csv\"\n    loss_path = exp_root / \"epoch_loss.csv\"\n\n    if not results_path.exists() or not loss_path.exists():\n        print(\n            f\"Skipping {row['experiment_id']}: \"\n            \"result or loss file missing.\"\n        )\n        continue\n\n    results_df = pd.read_csv(results_path)\n    loss_df = pd.read_csv(loss_path)\n\n    fig = plot_individual_results(\n        results_df, epochs, neurons, ic_weight,\n        exp_root / \"pinn_vs_rk4.png\",\n    )\n    display(fig)\n    plt.close(fig)\n\n    fig = plot_local_epoch_losses(\n        loss_df, epochs, neurons, ic_weight,\n        exp_root / \"epochs_vs_loss.png\",\n    )\n    display(fig)\n    plt.close(fig)\n\n    completed_runs_for_plot.append({\n        \"experiment_id\": row[\"experiment_id\"],\n        \"t\": results_df[\"t\"].to_numpy(dtype=float),\n        \"pinn\": results_df[\"PINN_x\"].to_numpy(dtype=float),\n        \"rk4\": results_df[\"RK4_x\"].to_numpy(dtype=float),\n        \"error\": results_df[\"PINN_minus_RK4_x\"].to_numpy(dtype=float),\n    })\n\ncombined_fig = plot_all_pinns(\n    completed_runs_for_plot,\n    RESULT_ROOT / \"all_pinn_vs_rk4.png\",\n)\n\nif combined_fig is not None:\n    display(combined_fig)\n    plt.close(combined_fig)\n\nprint(\"All available individual plots and the combined plot have been saved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T21:13:48.18847Z","iopub.execute_input":"2026-10-13T21:13:48.188778Z","iopub.status.idle":"2026-10-13T21:14:10.669326Z","shell.execute_reply.started":"2026-10-13T21:13:48.188755Z","shell.execute_reply":"2026-10-13T21:14:10.668595Z"}},"outputs":[{"output_type":"