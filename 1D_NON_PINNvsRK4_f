{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"\n# ============================================================\n# 1D LOGISTIC-GROWTH PINN — COMPLETE KAGGLE SCRIPT\n# TensorFlow/Keras | 6 experiments | 5-window time marching\n# RK4 reference only — no analytical solution is used.\n#\n# Equation: dx/dt = r*x*(1 - x/K)\n# Initial condition: x(0) = 100\n#\n# Experiments:\n#   (1000 epochs/window, 50 neurons, IC weight 1)\n#   (5000 epochs/window, 100 neurons, IC weight 1)\n#   (10000 epochs/window, 150 neurons, IC weight 1)\n#   Same three configurations with IC weight 10\n#\n# Displays inline:\n#   1. PINN vs RK4 for every experiment\n#   2. Epochs vs total, physics and IC losses\n#   3. Combined plot of all successful PINNs vs RK4\n#   4. Final metrics table\n#\n# Saves CSVs and PNGs under:\n# /kaggle/working/results/logistic_growth_1D\n#\n# NOTE: Running this script trains all six experiments from scratch.\n# ============================================================\n\nimport os\nimport time\nimport random\nimport traceback\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport tensorflow as tf\nfrom IPython.display import display\n\n\n# ============================================================\n# 1. CONFIGURATION\n# ============================================================\n\nSEED = 42\n\n# Logistic-growth equation\nR = 0.8\nK = 1000.0\nINITIAL_X = 100.0\nTOTAL_TIME = 1.0\nEQUATION = \"dx/dt = r*x*(1 - x/K)\"\n\n# Epochs per window and neurons per hidden layer\nMODEL_CONFIGS = [\n    {\"epochs\": 1000, \"neurons\": 50},\n    {\"epochs\": 5000, \"neurons\": 100},\n    {\"epochs\": 10000, \"neurons\": 150},\n]\n\nIC_WEIGHTS = [1.0, 10.0]\n\nWINDOWS = 5\nPHYSICS_POINTS = 100\nTEST_POINTS = 500\n\nHIDDEN_LAYERS = 3\nLEARNING_RATE = 0.001\nACTIVATION = \"tanh\"\n\nPRINT_EVERY = 100\n\nRESULT_ROOT = Path(\n    \"/kaggle/working/results/logistic_growth_1D\"\n)\nRESULT_ROOT.mkdir(parents=True, exist_ok=True)\n\nnp.random.seed(SEED)\nrandom.seed(SEED)\ntf.keras.utils.set_random_seed(SEED)\n\nTOTAL_EXPERIMENTS = len(MODEL_CONFIGS) * len(IC_WEIGHTS)\nTOTAL_UPDATES = (\n    sum(c[\"epochs\"] * WINDOWS for c in MODEL_CONFIGS)\n    * len(IC_WEIGHTS)\n)\n\n# Remove old root summaries so an interrupted run cannot make\n# previous summary files look like the results of this run.\nfor name in [\n    \"all_results.csv\",\n    \"best_result.csv\",\n    \"best_by_ic_weight.csv\",\n    \"all_pinn_vs_rk4.png\",\n    \"run_status.csv\",\n]:\n    p = RESULT_ROOT / name\n    if p.exists():\n        p.unlink()\n\nprint(\"=\" * 76)\nprint(\"LOGISTIC-GROWTH PINN EXPERIMENT\")\nprint(\"Equation:\", EQUATION)\nprint(f\"r={R}, K={K}, x(0)={INITIAL_X}, T={TOTAL_TIME}\")\nprint(\"Framework: TensorFlow/Keras\")\nprint(\"Optimizer: Adam\")\nprint(\"Learning rate:\", LEARNING_RATE)\nprint(\"IC weights:\", IC_WEIGHTS)\nprint(\"Configurations:\", MODEL_CONFIGS)\nprint(f\"Windows: {WINDOWS}\")\nprint(f\"Expected total optimizer updates: {TOTAL_UPDATES:,}\")\nprint(\"Reference: Python RK4\")\nprint(\"Analytical solution used: NO\")\nprint(\"Results:\", RESULT_ROOT)\nprint(\"=\" * 76)\n\n\n# ============================================================\n# 2. MODEL\n# ============================================================\n\ndef build_model(neurons):\n    model = tf.keras.Sequential([\n        tf.keras.layers.Input(shape=(1,)),\n        tf.keras.layers.Dense(neurons, activation=\"tanh\"),\n        tf.keras.layers.Dense(neurons, activation=\"tanh\"),\n        tf.keras.layers.Dense(neurons, activation=\"tanh\"),\n        tf.keras.layers.Dense(1, activation=None),\n    ])\n    return model\n\n\n# ============================================================\n# 3. INDEPENDENT PYTHON RK4 REFERENCE\n# ============================================================\n\ndef logistic_rhs(x):\n    return R * x * (1.0 - x / K)\n\n\ndef solve_rk4(times, initial_x):\n    times = np.asarray(times, dtype=np.float64).reshape(-1)\n\n    if len(times) < 2:\n        raise ValueError(\"RK4 needs at least two time points.\")\n\n    if not np.all(np.diff(times) > 0):\n        raise ValueError(\"RK4 times must be strictly increasing.\")\n\n    values = np.zeros(len(times), dtype=np.float64)\n    values[0] = initial_x\n\n    for i in range(len(times) - 1):\n        h = times[i + 1] - times[i]\n        x = values[i]\n\n        k1 = logistic_rhs(x)\n        k2 = logistic_rhs(x + 0.5 * h * k1)\n        k3 = logistic_rhs(x + 0.5 * h * k2)\n        k4 = logistic_rhs(x + h * k3)\n\n        values[i + 1] = x + (\n            h / 6.0\n        ) * (k1 + 2*k2 + 2*k3 + k4)\n\n    return values\n\n\n# ============================================================\n# 4. METADATA\n# ============================================================\n\ndef make_metadata(experiment_id, epochs, neurons, ic_weight):\n    return {\n        \"experiment_id\": experiment_id,\n        \"problem_id\": \"logistic_growth_1D\",\n        \"equation\": EQUATION,\n        \"r\": R,\n        \"K\": K,\n        \"initial_x\": INITIAL_X,\n        \"initial_condition\": f\"x(0)={INITIAL_X}\",\n        \"time_horizon\": TOTAL_TIME,\n        \"epochs_per_window\": epochs,\n        \"total_training_steps\": epochs * WINDOWS,\n        \"neurons_per_hidden_layer\": neurons,\n        \"hidden_layers\": HIDDEN_LAYERS,\n        \"activation\": ACTIVATION,\n        \"optimizer\": \"Adam\",\n        \"learning_rate\": LEARNING_RATE,\n        \"loss_formula\": f\"L_physics + {ic_weight:g}*L_IC\",\n        \"ic_weight\": ic_weight,\n        \"windows\": WINDOWS,\n        \"collocation_points_per_window\": PHYSICS_POINTS,\n        \"test_points\": TEST_POINTS,\n        \"random_seed\": SEED,\n        \"framework\": \"TensorFlow/Keras\",\n        \"training_execution\": \"@tf.function\",\n        \"reference_method\": \"Python RK4\",\n    }\n\n\ndef plot_footer(epochs, neurons, ic_weight):\n    return (\n        f\"Equation: {EQUATION} | x(0)={INITIAL_X} | \"\n        f\"r={R} | K={K} | IC weight={ic_weight:g}\\n\"\n        f\"Architecture: 1 -> {HIDDEN_LAYERS} hidden layers x \"\n        f\"{neurons} neurons -> 1 | Tanh hidden activation\\n\"\n        f\"Adam LR={LEARNING_RATE} | Epochs/window={epochs} | \"\n        f\"Windows={WINDOWS} | Collocation/window={PHYSICS_POINTS} | \"\n        f\"Test points={TEST_POINTS} | Seed={SEED}\"\n    )\n\n\n# ============================================================\n# 5. SUMMARY TRACKING\n# ============================================================\n\nall_metrics = []\nrun_status = []\n\n\ndef save_summaries():\n    if all_metrics:\n        df = pd.DataFrame(all_metrics)\n        df.to_csv(RESULT_ROOT / \"all_results.csv\", index=False)\n\n        best = df.loc[[df[\"relative_L2_error\"].idxmin()]].copy()\n        best[\"selection_criterion\"] = (\n            \"Minimum relative L2 error against Python RK4 \"\n            \"among completed tested configurations\"\n        )\n        best.to_csv(RESULT_ROOT / \"best_result.csv\", index=False)\n\n        best_by_weight = df.loc[\n            df.groupby(\"ic_weight\")[\"relative_L2_error\"].idxmin()\n        ].sort_values(\"ic_weight\")\n\n        best_by_weight.to_csv(\n            RESULT_ROOT / \"best_by_ic_weight.csv\", index=False\n        )\n\n    pd.DataFrame(run_status).to_csv(\n        RESULT_ROOT / \"run_status.csv\", index=False\n    )\n\n\n# ============================================================\n# 6. TRAIN ONE EXPERIMENT\n# ============================================================\n\ndef run_experiment(epochs, neurons, ic_weight):\n    experiment_id = (\n        f\"E{epochs}_N{neurons}_ICW{ic_weight:g}\"\n    )\n    folder = RESULT_ROOT / experiment_id\n    folder.mkdir(parents=True, exist_ok=True)\n\n    # Avoid mixing files from an earlier run of the same experiment.\n    for filename in [\n        \"pinn_output.csv\",\n        \"matlab_input.csv\",\n        \"rk4_reference.csv\",\n        \"epoch_loss.csv\",\n        \"metrics.csv\",\n        \"pinn_vs_rk4.png\",\n        \"epochs_vs_loss.png\",\n    ]:\n        old = folder / filename\n        if old.exists():\n            old.unlink()\n\n    metadata = make_metadata(\n        experiment_id, epochs, neurons, ic_weight\n    )\n\n    print(\"\\n\" + \"=\" * 76)\n    print(\"STARTING:\", experiment_id)\n    print(f\"Epochs/window={epochs:,} | Neurons={neurons}\")\n    print(f\"IC weight={ic_weight:g} | Windows={WINDOWS}\")\n    print(\"=\" * 76)\n\n    tf.keras.backend.clear_session()\n    tf.keras.utils.set_random_seed(SEED)\n\n    model = build_model(neurons)\n    optimizer = tf.keras.optimizers.Adam(\n        learning_rate=LEARNING_RATE\n    )\n\n    # Nested automatic differentiation:\n    # inner tape calculates dx/dt;\n    # outer tape differentiates the complete loss w.r.t. weights.\n    @tf.function\n    def train_step(t_physics, t_init, current_x0):\n        with tf.GradientTape() as parameter_tape:\n            with tf.GradientTape() as time_tape:\n                time_tape.watch(t_physics)\n                x_physics = model(t_physics, training=True)\n\n            dx_dt = time_tape.gradient(\n                x_physics, t_physics\n            )\n\n            residual = (\n                dx_dt\n                - R * x_physics * (1.0 - x_physics / K)\n            )\n\n            physics_loss = tf.reduce_mean(\n                tf.square(residual)\n            )\n\n            x_init_pred = model(t_init, training=True)\n            ic_loss = tf.reduce_mean(\n                tf.square(x_init_pred - current_x0)\n            )\n\n            total_loss = (\n                physics_loss + ic_weight * ic_loss\n            )\n\n        gradients = parameter_tape.gradient(\n            total_loss, model.trainable_variables\n        )\n\n        optimizer.apply_gradients(\n            zip(gradients, model.trainable_variables)\n        )\n\n        return total_loss, physics_loss, ic_loss\n\n    test_times = np.linspace(\n        0.0, TOTAL_TIME, TEST_POINTS, dtype=np.float64\n    )\n    pinn_predictions = np.full(\n        TEST_POINTS, np.nan, dtype=np.float64\n    )\n\n    window_edges = np.linspace(\n        0.0, TOTAL_TIME, WINDOWS + 1\n    )\n    current_x0 = tf.constant(INITIAL_X, dtype=tf.float32)\n\n    loss_records = []\n    global_step = 0\n    start_time = time.time()\n\n    # Model and optimizer are reused across windows.\n    # Each next window starts from the preceding predicted endpoint.\n    for wi in range(WINDOWS):\n        t_start = float(window_edges[wi])\n        t_end = float(window_edges[wi + 1])\n\n        t_physics = tf.reshape(\n            tf.linspace(\n                tf.constant(t_start, dtype=tf.float32),\n                tf.constant(t_end, dtype=tf.float32),\n                PHYSICS_POINTS,\n            ),\n            (-1, 1),\n        )\n\n        t_init = tf.constant(\n            [[t_start]], dtype=tf.float32\n        )\n\n        print(\n            f\"\\n{experiment_id} | Window {wi+1}/{WINDOWS} \"\n            f\"| [{t_start:.3f}, {t_end:.3f}]\"\n        )\n\n        for epoch in range(1, epochs + 1):\n            total, physics, ic = train_step(\n                t_physics, t_init, current_x0\n            )\n            global_step += 1\n\n            total_v = float(total.numpy())\n            physics_v = float(physics.numpy())\n            ic_v = float(ic.numpy())\n\n            loss_records.append({\n                \"global_step\": global_step,\n                \"window\": wi + 1,\n                \"epoch_in_window\": epoch,\n                \"total_loss\": total_v,\n                \"physics_loss\": physics_v,\n                \"ic_loss\": ic_v,\n                **metadata,\n            })\n\n            if epoch % PRINT_EVERY == 0 or epoch == epochs:\n                print(\n                    f\"\\r{experiment_id} | Window {wi+1}/{WINDOWS} \"\n                    f\"| Epoch {epoch:,}/{epochs:,} \"\n                    f\"| Step {global_step:,}/{epochs*WINDOWS:,} \"\n                    f\"| Total={total_v:.4e} \"\n                    f\"| Physics={physics_v:.4e} \"\n                    f\"| IC={ic_v:.4e}\",\n                    end=\"\",\n                    flush=True,\n                )\n\n        print()\n\n        # Evaluate each window immediately after training it.\n        # Half-open intervals prevent duplicate boundary predictions.\n        if wi < WINDOWS - 1:\n            mask = (\n                (test_times >= t_start)\n                & (test_times < t_end)\n            )\n        else:\n            mask = (\n                (test_times >= t_start)\n                & (test_times <= t_end)\n            )\n\n        if np.any(mask):\n            t_eval = tf.convert_to_tensor(\n                test_times[mask].reshape(-1, 1),\n                dtype=tf.float32,\n            )\n            pinn_predictions[mask] = (\n                model(t_eval, training=False)\n                .numpy().reshape(-1)\n            )\n\n        # Warm-start the next time window from this window's endpoint.\n        endpoint = model(\n            tf.constant([[t_end]], dtype=tf.float32),\n            training=False,\n        )\n        endpoint_value = float(endpoint.numpy()[0, 0])\n        current_x0 = tf.constant(\n            endpoint_value, dtype=tf.float32\n        )\n\n        print(\n            f\"Window {wi+1} complete | \"\n            f\"Predicted x({t_end:.3f})={endpoint_value:.6f}\"\n        )\n\n        # Recovery checkpoint after each window.\n        pd.DataFrame(loss_records).to_csv(\n            folder / \"epoch_loss.csv\", index=False\n        )\n\n    elapsed = time.time() - start_time\n\n    if np.isnan(pinn_predictions).any():\n        raise RuntimeError(\n            \"Some PINN test predictions were not generated.\"\n        )\n\n    # --------------------------------------------------------\n    # RK4 reference and error metrics\n    # --------------------------------------------------------\n\n    rk4_predictions = solve_rk4(\n        test_times, INITIAL_X\n    )\n    errors = pinn_predictions - rk4_predictions\n\n    mae = float(np.mean(np.abs(errors)))\n    mse = float(np.mean(errors ** 2))\n    rmse = float(np.sqrt(mse))\n    max_abs_error = float(np.max(np.abs(errors)))\n\n    norm_ref = np.linalg.norm(rk4_predictions)\n    relative_l2 = float(\n        np.linalg.norm(errors) / norm_ref\n        if norm_ref > 0 else np.linalg.norm(errors)\n    )\n\n    metrics = {\n        **metadata,\n        \"MAE\": mae,\n        \"MSE\": mse,\n        \"RMSE\": rmse,\n        \"relative_L2_error\": relative_l2,\n        \"max_absolute_error\": max_abs_error,\n        \"final_total_loss\": loss_records[-1][\"total_loss\"],\n        \"elapsed_seconds\": elapsed,\n        \"selection_reference\": \"Python RK4\",\n    }\n\n    # --------------------------------------------------------\n    # Save all experiment CSVs\n    # --------------------------------------------------------\n\n    pd.DataFrame({\n        \"time\": test_times,\n        \"pinn_x\": pinn_predictions,\n        \"rk4_x\": rk4_predictions,\n        \"absolute_error\": np.abs(errors),\n        \"signed_error\": errors,\n    }).assign(**metadata).to_csv(\n        folder / \"pinn_output.csv\", index=False\n    )\n\n    pd.DataFrame({\n        \"time\": test_times,\n        \"initial_x\": INITIAL_X,\n        \"r\": R,\n        \"K\": K,\n    }).assign(**metadata).to_csv(\n        folder / \"matlab_input.csv\", index=False\n    )\n\n    pd.DataFrame({\n        \"time\": test_times,\n        \"rk4_x\": rk4_predictions,\n    }).assign(**metadata).to_csv(\n        folder / \"rk4_reference.csv\", index=False\n    )\n\n    pd.DataFrame(loss_records).to_csv(\n        folder / \"epoch_loss.csv\", index=False\n    )\n\n    pd.DataFrame([metrics]).to_csv(\n        folder / \"metrics.csv\", index=False\n    )\n\n    # --------------------------------------------------------\n    # PLOT 1: PINN VS RK4 — INLINE AND SAVED\n    # --------------------------------------------------------\n\n    footer = plot_footer(epochs, neurons, ic_weight)\n\n    fig, ax = plt.subplots(figsize=(11, 6))\n\n    ax.plot(\n        test_times, rk4_predictions,\n        color=\"black\", linestyle=\"-\", linewidth=3.0,\n        label=\"Python RK4 reference\", zorder=5,\n    )\n    ax.plot(\n        test_times, pinn_predictions,\n        color=\"#D62728\", linestyle=\"--\", linewidth=2.4,\n        label=\"PINN prediction\", zorder=4,\n    )\n\n    ax.set_xlabel(\"Time\")\n    ax.set_ylabel(\"Population x(t)\")\n    ax.set_title(\n        f\"{experiment_id}\\nPINN vs Python RK4\"\n    )\n    ax.grid(True, alpha=0.3)\n    ax.legend()\n\n    fig.text(\n        0.01, 0.01, footer,\n        ha=\"left\", va=\"bottom\", fontsize=7, wrap=True,\n    )\n    fig.tight_layout(rect=[0, 0.12, 1, 1])\n\n    fig.savefig(\n        folder / \"pinn_vs_rk4.png\",\n        dpi=300, bbox_inches=\"tight\",\n    )\n\n    print(\"\\nPINN vs RK4 plot:\")\n    display(fig)\n    plt.close(fig)\n\n    # --------------------------------------------------------\n    # PLOT 2: EPOCHS VS LOSS — INLINE AND SAVED\n    # --------------------------------------------------------\n\n    loss_df = pd.DataFrame(loss_records)\n    tiny = np.finfo(float).tiny\n\n    fig, ax = plt.subplots(figsize=(11, 6))\n\n    ax.semilogy(\n        loss_df[\"global_step\"],\n        np.maximum(loss_df[\"total_loss\"], tiny),\n        color=\"#1F77B4\", linestyle=\"-\", linewidth=2.2,\n        label=\"Total loss\",\n    )\n    ax.semilogy(\n        loss_df[\"global_step\"],\n        np.maximum(loss_df[\"physics_loss\"], tiny),\n        color=\"#FF7F0E\", linestyle=\"--\", linewidth=2.0,\n        label=\"Physics loss\",\n    )\n    ax.semilogy(\n        loss_df[\"global_step\"],\n        np.maximum(loss_df[\"ic_loss\"], tiny),\n        color=\"#2CA02C\", linestyle=\"-.\", linewidth=2.0,\n        label=\"Initial-condition loss\",\n    )\n\n    # Vertical lines mark time-window boundaries.\n    for boundary in range(1, WINDOWS):\n        ax.axvline(\n            boundary * epochs,\n            color=\"gray\", linestyle=\":\", alpha=0.7,\n        )\n\n    ax.set_xlabel(\"Cumulative optimizer updates\")\n    ax.set_ylabel(\"Loss (log scale)\")\n    ax.set_title(f\"{experiment_id}\\nEpochs vs Loss\")\n    ax.grid(True, alpha=0.3)\n    ax.legend()\n\n    fig.text(\n        0.01, 0.01, footer,\n        ha=\"left\", va=\"bottom\", fontsize=7, wrap=True,\n    )\n    fig.tight_layout(rect=[0, 0.12, 1, 1])\n\n    fig.savefig(\n        folder / \"epochs_vs_loss.png\",\n        dpi=300, bbox_inches=\"tight\",\n    )\n\n    print(\"\\nEpochs vs Loss plot:\")\n    display(fig)\n    plt.close(fig)\n\n    # --------------------------------------------------------\n    # Display metrics immediately for this experiment\n    # --------------------------------------------------------\n\n    print(f\"\\nCompleted: {experiment_id}\")\n    print(f\"Training time: {elapsed:.1f} seconds\")\n    print(f\"MAE vs RK4: {mae:.6e}\")\n    print(f\"MSE vs RK4: {mse:.6e}\")\n    print(f\"RMSE vs RK4: {rmse:.6e}\")\n    print(f\"Relative L2 error vs RK4: {relative_l2:.6e}\")\n    print(f\"Maximum absolute error: {max_abs_error:.6e}\")\n    print(\"Files saved to:\", folder)\n\n    return metrics\n\n\n# ============================================================\n# 7. RUN ALL SIX EXPERIMENTS\n# ============================================================\n\ncompleted = 0\nfailed = 0\n\nfor ic_weight in IC_WEIGHTS:\n    for config in MODEL_CONFIGS:\n        epochs = config[\"epochs\"]\n        neurons = config[\"neurons\"]\n        experiment_id = (\n            f\"E{epochs}_N{neurons}_ICW{ic_weight:g}\"\n        )\n\n        try:\n            result = run_experiment(\n                epochs=epochs,\n                neurons=neurons,\n                ic_weight=ic_weight,\n            )\n\n            all_metrics.append(result)\n            completed += 1\n\n            run_status.append({\n                \"experiment_id\": experiment_id,\n                \"status\": \"COMPLETE\",\n                \"error\": \"\",\n            })\n\n            # Keep summaries current after every successful experiment.\n            save_summaries()\n\n        except Exception as exc:\n            failed += 1\n\n            run_status.append({\n                \"experiment_id\": experiment_id,\n                \"status\": \"FAILED\",\n                \"error\": f\"{type(exc).__name__}: {exc}\",\n            })\n\n            save_summaries()\n\n            print(f\"\\nFAILED: {experiment_id}\")\n            print(f\"{type(exc).__name__}: {exc}\")\n            traceback.print_exc()\n\n        print(\n            f\"\\nOverall progress: {completed + failed}/\"\n            f\"{TOTAL_EXPERIMENTS} | \"\n            f\"Completed={completed} | Failed={failed}\"\n        )\n\n\n# ============================================================\n# 8. COMBINED PLOT: ALL PINN CONFIGURATIONS VS RK4\n# ============================================================\n\ndef create_combined_plot():\n    if not all_metrics:\n        print(\"No successful experiments; combined plot skipped.\")\n        return\n\n    first_id = all_metrics[0][\"experiment_id\"]\n    ref_path = RESULT_ROOT / first_id / \"rk4_reference.csv\"\n\n    if not ref_path.exists():\n        print(\"RK4 reference file missing; combined plot skipped.\")\n        return\n\n    ref_df = pd.read_csv(ref_path)\n    times = ref_df[\"time\"].to_numpy()\n    rk4_values = ref_df[\"rk4_x\"].to_numpy()\n\n    fig, ax = plt.subplots(figsize=(13, 8))\n\n    ax.plot(\n        times, rk4_values,\n        color=\"black\", linestyle=\"-\", linewidth=3.2,\n        label=\"Python RK4 reference\", zorder=10,\n    )\n\n    colors = [\n        \"#D62728\", \"#1F77B4\", \"#2CA02C\",\n        \"#9467BD\", \"#FF7F0E\", \"#17BECF\",\n    ]\n    styles = [\"--\", \"-.\", \":\", \"-\", (0, (5, 1)), (0, (7, 2))]\n\n    plotted = 0\n\n    for i, result in enumerate(all_metrics):\n        experiment_id = result[\"experiment_id\"]\n        pred_path = RESULT_ROOT / experiment_id / \"pinn_output.csv\"\n\n        if not pred_path.exists():\n            continue\n\n        pred_df = pd.read_csv(pred_path)\n        pred_times = pred_df[\"time\"].to_numpy()\n        pred_values = pred_df[\"pinn_x\"].to_numpy()\n\n        if not np.allclose(pred_times, times):\n            print(\"Skipping mismatched time grid:\", experiment_id)\n            continue\n\n        ax.plot(\n            pred_times, pred_values,\n            color=colors[i % len(colors)],\n            linestyle=styles[i % len(styles)],\n            linewidth=2.0,\n            alpha=0.95,\n            label=(\n                f\"{experiment_id} \"\n                f\"(Rel. L2={result['relative_L2_error']:.2e})\"\n            ),\n        )\n        plotted += 1\n\n    ax.set_xlabel(\"Time\")\n    ax.set_ylabel(\"Population x(t)\")\n    ax.set_title(\n        \"All Completed PINN Configurations vs Python RK4\\n\"\n        \"Logistic Growth | x(0)=100 | r=0.8 | K=1000 | T=1\"\n    )\n    ax.grid(True, alpha=0.3)\n    ax.legend(fontsize=8, loc=\"best\")\n    fig.tight_layout()\n\n    output = RESULT_ROOT / \"all_pinn_vs_rk4.png\"\n    fig.savefig(output, dpi=300, bbox_inches=\"tight\")\n\n    print(\"\\nCOMBINED PINN VS RK4 PLOT:\")\n    display(fig)\n    plt.close(fig)\n\n    print(f\"Combined plot saved: {output}\")\n    print(f\"Curve