x_values[i + 1] = x + (\n            h / 6\n        ) * (k1 + 2*k2 + 2*k3 + k4)\n\n    return x_values\n\n\ndef run_experiment(\n    epochs, neurons, ic_weight,\n    progress_state, total_updates,\n):\n    exp_id = make_experiment_id(\n        epochs, neurons, ic_weight\n    )\n    exp_root = RESULT_ROOT / make_folder_name(\n        epochs, neurons, ic_weight\n    )\n    exp_root.mkdir(parents=True, exist_ok=True)\n\n    # Fixed experiment settings are saved once, not repeated down result rows.\n    pd.DataFrame([\n        settings_dict(epochs, neurons, ic_weight)\n    ]).to_csv(\n        exp_root / \"experiment_settings.csv\",\n        index=False,\n    )\n\n    tf.keras.backend.clear_session()\n    tf.random.set_seed(SEED)\n\n    model = build_model(neurons)\n    optimizer = tf.keras.optimizers.Adam(\n        learning_rate=LEARNING_RATE\n    )\n\n    window_edges = np.linspace(\n        0.0, TOTAL_TIME, WINDOWS + 1\n    )\n    current_x0 = tf.constant(\n        [[INITIAL_X]], dtype=tf.float32\n    )\n\n    global_step = 0\n    all_loss_history = []\n    experiment_start = time.time()\n\n    loss_path = exp_root / \"epoch_loss.csv\"\n    aggregate_loss_path = (\n        RESULT_ROOT / \"all_epoch_losses.csv\"\n    )\n\n    print(f\"\\nStarting {exp_id}\")\n\n    for w in range(WINDOWS):\n        window = w + 1\n        t_start = float(window_edges[w])\n        t_end = float(window_edges[w + 1])\n\n        t_physics = tf.reshape(\n            tf.linspace(t_start, t_end, PHYSICS_POINTS),\n            (-1, 1),\n        )\n        t_physics = tf.cast(t_physics, tf.float32)\n\n        t_init = tf.constant(\n            [[t_start]], dtype=tf.float32\n        )\n        window_rows = []\n\n        for epoch in range(1, epochs + 1):\n            with tf.GradientTape() as parameter_tape:\n                residual = physics_residual(\n                    model, t_physics\n                )\n                physics_loss = tf.reduce_mean(\n                    tf.square(residual)\n                )\n\n                x_init_pred = model(\n                    t_init, training=True\n                )\n                ic_loss = tf.reduce_mean(\n                    tf.square(x_init_pred - current_x0)\n                )\n\n                total_loss = (\n                    physics_loss + ic_weight * ic_loss\n                )\n\n            gradients = parameter_tape.gradient(\n                total_loss,\n                model.trainable_variables,\n            )\n\n            if any(g is None for g in gradients):\n                raise RuntimeError(\n                    f\"Missing parameter gradient in {exp_id}\"\n                )\n\n            optimizer.apply_gradients(\n                zip(gradients, model.trainable_variables)\n            )\n\n            global_step += 1\n            progress_state[\"updates_done\"] += 1\n\n            physics_value = float(physics_loss.numpy())\n            ic_value = float(ic_loss.numpy())\n            total_value = float(total_loss.numpy())\n\n            row = {\n                \"window\": window,\n                \"epoch\": epoch,\n                \"global_step\": global_step,\n                \"physics_loss\": physics_value,\n                \"ic_loss\": ic_value,\n                \"weighted_ic_loss\": ic_weight * ic_value,\n                \"total_loss\": total_value,\n            }\n\n            window_rows.append(row)\n            all_loss_history.append(row)\n\n            if epoch % 100 == 0 or epoch == epochs:\n                pct = (\n                    100 * progress_state[\"updates_done\"]\n                    / total_updates\n                )\n\n                status = (\n                    f\"Overall {pct:6.2f}% \"\n                    f\"({progress_state['updates_done']:,}/\"\n                    f\"{total_updates:,}) | {exp_id} | \"\n                    f\"window {window}/{WINDOWS} | \"\n                    f\"epoch {epoch:,}/{epochs:,} | \"\n                    f\"loss={total_value:.5e}\"\n                )\n\n                try:\n                    progress_state[\"display_handle\"].update(status)\n                except Exception:\n                    print(status, flush=True)\n\n        # Exactly one row per epoch, all three loss components side by side.\n        window_df = pd.DataFrame(window_rows, columns=[\n            \"window\",\n            \"epoch\",\n            \"global_step\",\n            \"physics_loss\",\n            \"ic_loss\",\n            \"weighted_ic_loss\",\n            \"total_loss\",\n        ])\n\n        # Checkpoint the completed window inside this experiment's folder.\n        window_df.to_csv(\n            loss_path,\n            mode=\"a\" if loss_path.exists() else \"w\",\n            header=not loss_path.exists(),\n            index=False,\n        )\n\n        # Combined loss history: one epoch record per row, identified by run.\n        combined_loss = window_df.copy()\n        combined_loss.insert(0, \"experiment_id\", exp_id)\n\n        combined_loss.to_csv(\n            aggregate_loss_path,\n            mode=\"a\" if aggregate_loss_path.exists() else \"w\",\n            header=not aggregate_loss_path.exists(),\n            index=False,\n        )\n\n        # Carry the predicted boundary state into the next window.\n        current_x0 = tf.stop_gradient(\n            model(\n                tf.constant([[t_end]], dtype=tf.float32),\n                training=False,\n            )\n        )\n\n    # IMPORTANT:\n    # Evaluate the FINAL model across the complete time grid.\n    # Do not stitch predictions saved from different model checkpoints;\n    # that creates artificial jumps at window boundaries.\n    t_tensor = tf.convert_to_tensor(\n        SHARED_T_EVAL.reshape(-1, 1),\n        dtype=tf.float32,\n    )\n    pinn_x = (\n        model(t_tensor, training=False)\n        .numpy()\n        .reshape(-1)\n        .astype(np.float64)\n    )\n\n    rk4_x = SHARED_X_RK4.copy()\n    error = pinn_x - rk4_x\n    absolute_error = np.abs(error)\n    squared_error = np.square(error)\n\n    mse = float(np.mean(squared_error))\n    rmse = float(np.sqrt(mse))\n    mae = float(np.mean(absolute_error))\n    relative_l2 = float(\n        np.linalg.norm(error) / np.linalg.norm(rk4_x)\n    )\n    max_error = float(np.max(absolute_error))\n    duration = float(time.time() - experiment_start)\n\n    # Detailed comparison, one row per time point.\n    results_df = pd.DataFrame({\n        \"t\": SHARED_T_EVAL,\n        \"PINN_x\": pinn_x,\n        \"RK4_x\": rk4_x,\n        \"PINN_minus_RK4_x\": error,\n        \"Absolute_difference\": absolute_error,\n        \"Squared_difference\": squared_error,\n    })\n    results_df.to_csv(\n        exp_root / \"results.csv\", index=False\n    )\n\n    # Separate PINN and RK4 data, as requested.\n    pd.DataFrame({\n        \"t\": SHARED_T_EVAL,\n        \"PINN_x\": pinn_x,\n    }).to_csv(\n        exp_root / \"pinn_output.csv\", index=False\n    )\n\n    pd.DataFrame({\n        \"t\": SHARED_T_EVAL,\n        \"PINN_x\": pinn_x,\n    }).to_csv(\n        exp_root / \"matlab_input.csv\", index=False\n    )\n\n    pd.DataFrame({\n        \"t\": SHARED_T_EVAL,\n        \"RK4_x\": rk4_x,\n    }).to_csv(\n        exp_root / \"rk4_reference.csv\", index=False\n    )\n\n    # Experiment-level metrics: exactly one row per run.\n    pd.DataFrame([{\n        \"MSE\": mse,\n        \"RMSE\": rmse,\n        \"MAE\": mae,\n        \"Relative_L2_error\": relative_l2,\n        \"Max_absolute_error\": max_error,\n        \"reference_method\": REFERENCE_METHOD,\n        \"prediction_points\": len(SHARED_T_EVAL),\n        \"duration_seconds\": duration,\n    }]).to_csv(\n        exp_root / \"metrics.csv\", index=False\n    )\n\n    result = {\n        \"experiment_id\": exp_id,\n        \"epochs_per_window\": epochs,\n        \"neurons_per_layer\": neurons,\n        \"ic_weight\": ic_weight,\n        \"status\": \"completed\",\n        \"error_message\": \"\