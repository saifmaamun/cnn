{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ============================================================================\n# Kaggle-ready PINN experiment: 1D nonlinear logistic-growth ODE\n# Equation: dx/dt = r*x*(1 - x/K), x(0) = INITIAL_X\n# Reference: independent Python RK4. No analytical solution is used.\n#\n# OUTPUTS\n#   complete_experiment_data.csv\n#       One master CSV: settings, predictions, RK4, errors, training losses,\n#       and final metrics for all experiments.\n#   all_results.csv\n#       One row per experiment, run status, metrics, and best-run flags.\n#   all_pinn_vs_rk4.png\n#       Combined plot for all completed configurations.\n#   One folder per experiment, containing:\n#       pinn_vs_rk4.png\n#       epochs_vs_loss.png\n#\n# TRAINING STRUCTURE\n#   - Eager TensorFlow/Keras; no @tf.function\n#   - One model warm-started across five sequential time windows\n#   - Three hidden Tanh layers; Adam optimizer\n#   - IC loss weight is tested at 1 and 10\n# ============================================================================\n\nimport gc\nimport random\nimport shutil\nimport time\nfrom pathlib import Path\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nimport tensorflow as tf\nfrom IPython.display import Image, display\n\n\n# ---------------------------------------------------------------------------\n# 1. Reproducibility and device setup\n# ---------------------------------------------------------------------------\nSEED = 42\nnp.random.seed(SEED)\nrandom.seed(SEED)\ntf.random.set_seed(SEED)\n\n# Allow dynamic GPU memory allocation, where supported.\nfor gpu in tf.config.list_physical_devices(\"GPU\"):\n    try:\n        tf.config.experimental.set_memory_growth(gpu, True)\n    except (RuntimeError, ValueError):\n        pass\n\nprint(\"TensorFlow:\", tf.__version__)\nprint(\"Detected GPUs:\", tf.config.list_physical_devices(\"GPU\"))\nprint(\"Note: this script does not distribute training across both T4 GPUs.\")\n\n\n# ---------------------------------------------------------------------------\n# 2. Experiment configurations\n# ---------------------------------------------------------------------------\nBASE_CONFIGS = [\n    (1000, 50),\n    (5000, 100),\n    (10000, 150),\n]\n\nIC_WEIGHTS = [1.0, 10.0]\n\n# Six experiments: three epoch/neuron pairs, each using IC weight 1 and 10.\nCONFIGS = [\n    (epochs, neurons, ic_weight)\n    for ic_weight in IC_WEIGHTS\n    for epochs, neurons in BASE_CONFIGS\n]\n\n# Fixed problem and model settings.\nR = 0.8\nK = 1000.0\nINITIAL_X = 100.0\nTOTAL_TIME = 1.0\n\nWINDOWS = 5\nPHYSICS_POINTS = 100\nTEST_POINTS = 500\n\nHIDDEN_LAYERS = 3\nLEARNING_RATE = 0.001\nOPTIMIZER_NAME = \"Adam\"\nACTIVATION = \"Tanh\"\n\nLOSS_FORMULA = \"L_total = L_physics + IC_WEIGHT * L_IC\"\nEQUATION = \"dx/dt = r*x*(1 - x/K)\"\nINITIAL_CONDITION = \"x(0) = 100\"\nREFERENCE_METHOD = \"Python RK4\"\n\nRESULT_ROOT = Path(\"/kaggle/working/results/logistic_growth_1D\")\nMASTER_CSV = RESULT_ROOT / \"complete_experiment_data.csv\"\nSUMMARY_CSV = RESULT_ROOT / \"all_results.csv\"\nCOMBINED_PLOT = RESULT_ROOT / \"all_pinn_vs_rk4.png\"\n\n# WARNING:\n# True removes previous contents of RESULT_ROOT before a new run.\n# Download previous results first if you need to preserve them.\nRESET_OUTPUT_DIRECTORY = True\n\n\n# ---------------------------------------------------------------------------\n# 3. Experiment metadata and master CSV layout\n# ---------------------------------------------------------------------------\ndef weight_tag(ic_weight):\n    \"\"\"Make the IC weight safe to use in file and experiment names.\"\"\"\n    return f\"{ic_weight:g}\".replace(\".\", \"p\")\n\n\ndef make_experiment_id(epochs, neurons, ic_weight):\n    return f\"LOG-E{epochs}-N{neurons}-ICW{weight_tag(ic_weight)}\"\n\n\ndef make_folder_name(epochs, neurons, ic_weight):\n    return f\"E{epochs}_N{neurons}_ICW{weight_tag(ic_weight)}\"\n\n\ndef metadata(epochs, neurons, ic_weight, data_type):\n    return {\n        \"experiment_id\": make_experiment_id(\n            epochs, neurons, ic_weight\n        ),\n        \"problem_id\": \"LOGISTIC_1D\",\n        \"dimension\": \"1D\",\n        \"problem_type\": \"Nonlinear ODE\",\n        \"equation\": EQUATION,\n        \"r\": R,\n        \"K\": K,\n        \"initial_condition\": INITIAL_CONDITION,\n        \"initial_x\": INITIAL_X,\n        \"time_horizon\": TOTAL_TIME,\n        \"epochs_per_window\": epochs,\n        \"total_training_steps\": epochs * WINDOWS,\n        \"neurons_per_layer\": neurons,\n        \"input_dimension\": 1,\n        \"output_dimension\": 1,\n        \"hidden_layers\": HIDDEN_LAYERS,\n        \"activation\": ACTIVATION,\n        \"optimizer\": OPTIMIZER_NAME,\n        \"learning_rate\": LEARNING_RATE,\n        \"loss_formula\": LOSS_FORMULA,\n        \"ic_weight\": ic_weight,\n        \"windows\": WINDOWS,\n        \"collocation_points_per_window\": PHYSICS_POINTS,\n        \"test_points\": TEST_POINTS,\n        \"random_seed\": SEED,\n        \"reference_method\": REFERENCE_METHOD,\n        \"data_type\": data_type,\n    }\n\n\n# All record types are aligned to the same columns before appending.\n# This prevents prediction, loss, and metric values shifting into wrong\n# columns when different record types are stored in the same CSV.\nMASTER_COLUMNS = [\n    \"record_type\",\n    \"experiment_id\",\n    \"problem_id\",\n    \"dimension\",\n    \"problem_type\",\n    \"equation\",\n    \"r\",\n    \"K\",\n    \"initial_condition\",\n    \"initial_x\",\n    \"time_horizon\",\n    \"epochs_per_window\",\n    \"total_training_steps\",\n    \"neurons_per_layer\",\n    \"input_dimension\",\n    \"output_dimension\",\n    \"hidden_layers\",\n    \"activation\",\n    \"optimizer\",\n    \"learning_rate\",\n    \"loss_formula\",\n    \"ic_weight\",\n    \"windows\",\n    \"collocation_points_per_window\",\n    \"test_points\",\n    \"random_seed\",\n    \"reference_method\",\n    \"data_type\",\n    # Prediction records\n    \"time\",\n    \"pinn_x\",\n    \"rk4_x\",\n    \"signed_error\",\n    \"absolute_error\",\n    \"squared_error\",\n    # Training-loss records\n    \"global_step\",\n    \"window\",\n    \"epoch_in_window\",\n    \"window_t_start\",\n    \"window_t_end\",\n    \"physics_loss\",\n    \"ic_loss\",\n    \"weighted_ic_loss\",\n    \"total_loss\",\n    # Experiment metrics\n    \"mae\",\n    \"mse\",\n    \"rmse\",\n    \"relative_l2_error\",\n    \"max_absolute_error\",\n    \"selection_metric\",\n]\n\n\ndef append_master_rows(\n    data_df, record_type, epochs, neurons, ic_weight\n):\n    \"\"\"Append one type of record with stable master-CSV column ordering.\"\"\"\n    data_df = data_df.copy().reset_index(drop=True)\n\n    meta = metadata(epochs, neurons, ic_weight, record_type)\n    meta_df = pd.DataFrame([meta] * len(data_df))\n\n    combined = pd.concat([meta_df, data_df], axis=1)\n    combined.insert(0, \"record_type\", record_type)\n    combined = combined.reindex(columns=MASTER_COLUMNS)\n\n    combined.to_csv(\n        MASTER_CSV,\n        mode=\"a\",\n        header=not MASTER_CSV.exists(),\n        index=False,\n    )\n\n\ndef write_summary(summary_rows):\n    \"\"\"Save experiment status and identify the best completed runs.\"\"\"\n    summary_df = pd.DataFrame(summary_rows)\n\n    if summary_df.empty:\n        summary_df.to_csv(SUMMARY_CSV, index=False)\n        return summary_df\n\n    summary_df[\"best_overall\"] = False\n    summary_df[\"best_within_ic_weight\"] = False\n\n    completed = summary_df[\n        (summary_df[\"status\"] == \"completed\")\n        & summary_df[\"relative_l2_error\"].notna()\n    ]\n\n    if not completed.empty:\n        best_index = completed[\"relative_l2_error\"].idxmin()\n        summary_df.loc[best_index, \"best_overall\"] = True\n\n        for _, group in completed.groupby(\"ic_weight\"):\n            best_index = group[\"relative_l2_error\"].idxmin()\n            summary_df.loc[\n                best_index, \"best_within_ic_weight\"\n            ] = True\n\n    summary_df.to_csv(SUMMARY_CSV, index=False)\n    return summary_df\n\n\n# ---------------------------------------------------------------------------\n# 4. Model, ODE residual, and independent Python RK4 reference\n# ---------------------------------------------------------------------------\ndef build_model(neurons):\n    layers = [tf.keras.layers.Input(shape=(1,))]\n\n    for _ in range(HIDDEN_LAYERS):\n        layers.append(\n            tf.keras.layers.Dense(\n                neurons,\n                activation=\"tanh\",\n            )\n        )\n\n    layers.append(\n        tf.keras.layers.Dense(1, activation=\"linear\")\n    )\n\n    return tf.keras.Sequential(layers)\n\n\ndef rhs(t, x):\n    return R * x * (1.0 - x / K)\n\n\ndef physics_residual(model, t):\n    \"\"\"Calculate dx/dt - RHS using automatic differentiation.\"\"\"\n    t = tf.cast(t, tf.float32)\n\n    with tf.GradientTape() as time_tape:\n        time_tape.watch(t)\n        x = model(t, training=True)\n\n    # Each batch row is independent, so differentiating the sum of outputs\n    # returns the corresponding derivative for each time input.\n    dx_dt = time_tape.gradient(x, t)\n\n    if dx_dt is None:\n        raise RuntimeError(\n            \"Could not calculate dx/dt. Check model and gradient tape.\"\n        )\n\n    return dx_dt - rhs(t, x)\n\n\ndef rk4_solution(t_values):\n    \"\"\"Solve the logistic ODE with classical fixed-grid RK4.\"\"\"\n    t_values = np.asarray(\n        t_values, dtype=np.float64\n    ).flatten()\n\n    if len(t_values) < 2:\n        raise ValueError(\"RK4 requires at least two time points.\")\n\n    x_values = np.zeros(len(t_values), dtype=np.float64)\n    x_values[0] = INITIAL_X\n\n    def f(_t, x):\n        return R * x * (1.0 - x / K)\n\n    for i in range(len(t_values) - 1):\n        h = t_values[i + 1] - t_values[i]\n        ti = t_values[i]\n        xi = x_values[i]\n\n        k1 = f(ti, xi)\n        k2 = f(ti + h / 2.0, xi + h * k1 / 2.0)\n        k3 = f(ti + h / 2.0, xi + h * k2 / 2.0)\n        k4 = f(ti + h, xi + h * k3)\n\n        x_values[i + 1] = xi + (h / 6.0) * (\n            k1 + 2.0 * k2 + 2.0 * k3 + k4\n        )\n\n    return x_values\n\n\n# ---------------------------------------------------------------------------\n# 5. Plotting functions\n# ---------------------------------------------------------------------------\ndef make_solution_plot(\n    t_eval,\n    x_pinn,\n    x_rk4,\n    errors,\n    epochs,\n    neurons,\n    ic_weight,\n    output_path,\n):\n    exp_id = make_experiment_id(epochs, neurons, ic_weight)\n\n    fig, axes = plt.subplots(\n        nrows=2,\n        ncols=1,\n        figsize=(11, 8),\n        sharex=True,\n        gridspec_kw={\"height_ratios\": [2, 1]},\n    )\n\n    axes[0].plot(\n        t_eval,\n        x_rk4,\n        color=\"black\",\n        linewidth=2.4,\n        label=\"Python RK4 reference\",\n    )\n    axes[0].plot(\n        t_eval,\n        x_pinn,\n        linestyle=\"--\",\n        linewidth=1.8,\n        label=\"PINN prediction\",\n    )\n\n    axes[0].set_ylabel(\"State x(t)\")\n    axes[0].set_title(\n        f\"{exp_id}\\n\"\n        f\"{EQUATION}; x(0)={INITIAL_X}, r={R}, K={K}\"\n    )\n    axes[0].grid(True, alpha=0.3)\n    axes[0].legend()\n\n    axes[1].plot(\n        t_eval,\n        np.abs(errors),\n        linewidth=1.5,\n        label=\"Absolute error\",\n    )\n    axes[1].set_xlabel(\"Time, t\")\n    axes[1].set_ylabel(\"|PINN - RK4|\")\n    axes[1].grid(True, alpha=0.3)\n    axes[1].legend()\n\n    fig.text(\n        0.5,\n        0.005,\n        f\"Architecture: 1-{neurons}x{HIDDEN_LAYERS}-1 | \"\n        f\"{ACTIVATION} | {OPTIMIZER_NAME}, lr={LEARNING_RATE} | \"\n        f\"IC weight={ic_weight} | windows={WINDOWS} | \"\n        f\"collocation points/window={PHYSICS_POINTS} | seed={SEED}\",\n        ha=\"center\",\n        fontsize=8,\n    )\n\n    fig.tight_layout(rect=[0, 0.035, 1, 1])\n    fig.savefig(output_path, dpi=200, bbox_inches=\"tight\")\n    return fig\n\n\ndef make_local_epoch_loss_plot(\n    loss_history,\n    window_edges,\n    epochs,\n    neurons,\n    ic_weight,\n    output_path,\n):\n    \"\"\"\n    Plot loss against local epoch in separate panels.\n\n    Each window's x-axis runs from epoch 1 to the configured epoch count.\n    The green curve is the weighted IC contribution, IC_WEIGHT * L_IC.\n    \"\"\"\n    exp_id = make_experiment_id(epochs, neurons, ic_weight)\n\n    loss_df = pd.DataFrame(\n        loss_history,\n        columns=[\n            \"global_step\",\n            \"window\",\n            \"epoch_in_window\",\n            \"physics_loss\",\n            \"ic_loss\",\n            \"total_loss\",\n        ],\n    )\n\n    fig, axes = plt.subplots(\n        nrows=WINDOWS,\n        ncols=1,\n        figsize=(12, max(12, 2.7 * WINDOWS)),\n        sharex=True,\n    )\n    axes = np.atleast_1d(axes)\n    tiny = np.finfo(np.float64).tiny\n\n    for window_number, ax in enumerate(axes, start=1):\n        window_df = loss_df[\n            loss_df[\"window\"] == window_number\n        ].sort_values(\"epoch_in_window\")\n\n        if window_df.empty:\n            ax.set_title(\n                f\"Window {window_number}: no recorded loss\"\n            )\n            continue\n\n        local_epochs = window_df[\"epoch_in_window\"].to_numpy()\n        physics_loss = window_df[\"physics_loss\"].to_numpy()\n        weighted_ic = (\n            ic_weight * window_df[\"ic_loss\"].to_numpy()\n        )\n        total_loss = window_df[\"total_loss\"].to_numpy()\n\n        ax.plot(\n            local_epochs,\n            np.maximum(total_loss, tiny),\n            color=\"tab:blue\",\n            linewidth=1.4,\n            label=\"Total loss\",\n        )\n\n        ax.plot(\n            local_epochs,\n            np.maximum(physics_loss, tiny),\n            color=\"tab:orange\",\n            linestyle=\"--\",\n            linewidth=1.2,\n            label=\"Physics loss\",\n        )\n\n        ax.plot(\n            local_epochs,\n            np.maximum(weighted_ic, tiny),\n            color=\"tab:green\",\n            linestyle=\"-.\",\n            linewidth=1.2,\n            label=\"Weighted IC contribution\",\n        )\n\n        t_start = window_edges[window_number - 1]\n        t_end = window_edges[window_number]\n\n        ax.set_title(\n            f\"Window {window_number}: \"\n            f\"t = {t_start:.2f} to {t_end:.2f}\",\n            loc=\"left\",\n            fontsize=10,\n        )\n        ax.set_ylabel(\"Loss (log scale)\")\n        ax.set_yscale(\"log\")\n        ax.set_xlim(1, epochs)\n        ax.grid(True, which=\"both\", alpha=0.25)\n        ax.legend(loc=\"best\", fontsize=8, ncol=3)\n\n    axes[-1].set_xlabel(\"Epoch within the current window\")\n\n    fig.suptitle(\n        f\"{exp_id} | Training loss vs local epoch\\n\"\n        \"Epoch axis restarts at 1 for each window\",\n        fontsize=13,\n        y=1.002,\n    )\n\n    fig.tight_layout()\n    fig.savefig(output_path, dpi=200, bbox_inches=\"tight\")\n    return fig\n\n\ndef make_combined_plot(completed_runs, output_path):\n    \"\"\"Compare all completed PINNs with the shared RK4 reference.\"\"\"\n    if not completed_runs:\n        return None\n\n    fig, axes = plt.subplots(\n        nrows=2,\n        ncols=1,\n        figsize=(13, 9),\n        sharex=True,\n        gridspec_kw={\"height_ratios\": [2, 1]},\n    )\n\n    first_run = completed_runs[0]\n\n    axes[0].plot(\n        first_run[\"time\"],\n        first_run[\"rk4\"],\n        color=\"black\",\n        linewidth=3.0,\n        label=\"Python RK4 reference\",\n        zorder=10,\n    )\n\n    palette = plt.get_cmap(\"tab10\")\n\n    for index, run in enumerate(completed_runs):\n        color = palette(index % 10)\n        label = run[\"experiment_id\"]\n\n        axes[0].plot(\n            run[\"time\"],\n            run[\"pinn\"],\n            color=color,\n            linewidth=1.4,\n            linestyle=\"--\",\n            label=label,\n        )\n\n        axes[1].plot(\n            run[\"time\"],\n            np.abs(run[\"error\"]),\n            color=color,\n            linewidth=1.3,\n            label=label,\n        )\n\n    axes[0].set_ylabel(\"State x(t)\")\n    axes[0].set_title(\n        \"All completed PINN configurations vs Python RK4\"\n    )\n    axes[0].grid(True, alpha=0.3)\n    axes[0].legend(fontsize=8, ncol=2)\n\n    axes[1].set_xlabel(\"Time, t\")\n    axes[1].set_ylabel(\"Absolute error\")\n    axes[1].grid(True, alpha=0.3)\n    axes[1].legend(fontsize=8, ncol=2)\n\n    fig.tight_layout()\n    fig.savefig(output_path, dpi=200, bbox_inches=\"tight\")\n    return fig\n\n\n# ---------------------------------------------------------------------------\n# 6. Train, checkpoint, evaluate, and save one experiment\n# ---------------------------------------------------------------------------\ndef run_experiment(\n    epochs,\n    neurons,\n    ic_weight,\n    progress_state,\n    total_updates,\n):\n    exp_id = make_experiment_id(epochs, neurons, ic_weight)\n    exp_root = RESULT_ROOT / make_folder_name(\n        epochs, neurons, ic_weight\n    )\n    exp_root.mkdir(parents=True, exist_ok=True)\n\n    tf.keras.backend.clear_session()\n    tf.random.set_seed(SEED)\n\n    model = build_model(neurons)\n    optimizer = tf.keras.optimizers.Adam(\n        learning_rate=LEARNING_RATE\n    )\n\n    # Initial condition of the first window. Later windows receive the\n    # previous window's predicted boundary state.\n    current_x0 = tf.constant([[INITIAL_X]], dtype=tf.float32)\n\n    window_edges = np.linspace(\n        0.0, TOTAL_TIME, WINDOWS + 1\n    )\n    t_eval = np.linspace(\n        0.0, TOTAL_TIME, TEST_POINTS, dtype=np.float64\n    )\n    x_predictions = np.full(\n        TEST_POINTS, np.nan, dtype=np.float64\n    )\n\n    all_loss_history = []\n    experiment_start = time.time()\n    experiment_local_step = 0\n\n    print(f\"\\nStarting {exp_id}\")\n\n    for w in range(WINDOWS):\n        window_number = w + 1\n        t_start = float(window_edges[w])\n        t_end = float(window_edges[w + 1])\n\n        t_physics = tf.reshape(\n            tf.linspace(t_start, t_end, PHYSICS_POINTS),\n            (-1, 1),\n        )\n        t_physics = tf.cast(t_physics, tf.float32)\n\n        t_init = tf.constant([[t_start]], dtype=tf.float32)\n        current_window_history = []\n\n        for ep in range(1, epochs + 1):\n            with tf.GradientTape() as parameter_tape:\n                residual = physics_residual(model, t_physics)\n                physics_loss = tf.reduce_mean(\n                    tf.square(residual)\n                )\n\n                x_init_pred = model(t_init, training=True)\n                ic_loss = tf.reduce_mean(\n                    tf.square(x_init_pred - current_x0)\n                )\n\n                total_loss_value = (\n                    physics_loss + ic_weight * ic_loss\n                )\n\n            gradients = parameter_tape.gradient(\n                total_loss_value,\n                model.trainable_variables,\n            )\n\n            if any(gradient is None for gradient in gradients):\n                raise RuntimeError(\n                    f\"A trainable variable has no gradient in {exp_id}.\"\n                )\n\n            optimizer.apply_gradients(\n                zip(gradients, model.trainable_variables)\n            )\n\n            experiment_local_step += 1\n            progress_state[\"updates_done\"] += 1\n\n            loss_row = [\n                experiment_local_step,\n                window_number,\n                ep,\n                float(physics_loss.numpy()),\n                float(ic_loss.numpy()),\n                float(total_loss_value.numpy()),\n            ]\n\n            current_window_history.append(loss_row)\n            all_loss_history.append(loss_row)\n\n            # Refresh the single progress display every 100 epochs and\n            # at the last epoch of each window.\n            if ep % 100 == 0 or ep == epochs:\n                percent = (\n                    100.0\n                    * progress_state[\"updates_done\"]\n                    / total_updates\n                )\n\n                status = (\n                    f\"Overall {percent:6.2f}% \"\n                    f\"({progress_state['updates_done']:,}/\"\n                    f\"{total_updates:,} updates) | {exp_id} | \"\n                    f\"window {window_number}/{WINDOWS} | \"\n                    f\"epoch {ep:,}/{epochs:,} | \"\n                    f\"total loss={float(total_loss_value.numpy()):.5e}\"\n                )\n\n                try:\n                    progress_state[\"display_handle\"].update(status)\n                except Exception:\n                    print(status, flush=True)\n\n        # Checkpoint this completed window's losses to the master CSV.\n        # If a later window fails, the finished windows remain recorded.\n        window_loss_df = pd.DataFrame(\n            current_window_history,\n            columns=[\n                \"global_step\",\n                \"window\",\n                \"epoch_in_window\",\n                \"physics_loss\",\n                \"ic_loss\",\n                \"total_loss\",\n            ],\n        )\n\n        window_loss_df[\"weighted_ic_loss\"] = (\n            ic_weight * window_loss_df[\"ic_loss\"]\n        )\n        window_loss_df[\"window_t_start\"] = t_start\n        window_loss_df[\"window_t_end\"] = t_end\n\n        append_master_rows(\n            window_loss_df,\n            \"training_loss\",\n            epochs,\n            neurons,\n            ic_weight,\n        )\n\n        # Half-open intervals prevent duplicate boundary predictions.\n        # The final interval includes TOTAL_TIME.\n        if w < WINDOWS - 1:\n            mask = (t_eval >= t_start) & (t_eval < t_end)\n        else:\n            mask = (t_eval >= t_start) & (t_eval <= t_end)\n\n        t_window = t_eval[mask]\n        x_window = model(\n            tf.convert_to_tensor(\n                t_window.reshape(-1, 1),\n                dtype=tf.float32,\n            ),\n            training=False,\n        ).numpy().flatten()\n\n        x_predictions[mask] = x_window\n\n        # Boundary state for the next time window.\n        t_boundary = tf.constant([[t_end]], dtype=tf.float32)\n        current_x0 = tf.stop_gradient(\n            model(t_boundary, training=False)\n        )\n\n    if np.isnan(x_predictions).any():\n        raise RuntimeError(\n            f\"Some test points have no PINN predictions in {exp_id}.\"\n        )\n\n    # Independent numerical reference: no analytical solution used.\n    x_rk4 = rk4_solution(t_eval)\n\n    error = x_predictions - x_rk4\n    abs_error = np.abs(error)\n\n    mse = float(np.mean(np.square(error)))\n    rmse = float(np.sqrt(mse))\n    mae = float(np.mean(abs_error))\n    relative_l2 = float(\n        np.linalg.norm(error) / np.linalg.norm(x_rk4)\n    )\n    max_error = float(np.max(abs_error))\n    duration_seconds = float(time.time() - experiment_start)\n\n    # Append the point-by-point predictions, RK4, and errors.\n    prediction_df = pd.DataFrame({\n        \"time\": t_eval,\n        \"pinn_x\": x_predictions,\n        \"rk4_x\": x_rk4,\n        \"signed_error\": error,\n        \"absolute_error\": abs_error,\n        \"squared_error\"