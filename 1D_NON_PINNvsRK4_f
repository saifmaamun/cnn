ht\n    )\n    start_time = time.time()\n\n    # Persist the running status before training starts.\n    summary_rows[config_index][\"status\"] = \"running\"\n    summary_rows[config_index][\"error_message\"] = \"\"\n    write_summary(summary_rows)\n\n    try:\n        result = run_experiment(\n            epochs,\n            neurons,\n            ic_weight,\n            progress_state,\n            total_updates,\n        )\n\n        summary_rows[config_index].update(result)\n        summary_rows[config_index][\"status\"] = \"completed\"\n        summary_rows[config_index][\"error_message\"] = \"\"\n\n    except Exception as exc:\n        # Keep previously checkpointed loss history if this configuration\n        # fails, and proceed to the remaining configurations.\n        summary_rows[config_index][\"status\"] = \"failed\"\n        summary_rows[config_index][\"error_message\"] = (\n            f\"{type(exc).__name__}: {exc}\"\n        )\n        summary_rows[config_index][\"duration_seconds\"] = (\n            time.time() - start_time\n        )\n\n        print(\n            f\"\\nFAILED {exp_id}: \"\n            f\"{type(exc).__name__}: {exc}\"\n        )\n\n    write_summary(summary_rows)\n    gc.collect()\n\n\n# ---------------------------------------------------------------------------\n# Final compact summary and best-run tables\n# ---------------------------------------------------------------------------\nfinal_summary = write_summary(summary_rows)\n\ncompleted_summary = final_summary[\n    (final_summary[\"status\"] == \"completed\")\n    & final_summary[\"relative_l2_error\"].notna()\n].copy()\n\nbest_result_path = RESULT_ROOT / \"best_result.csv\"\nbest_by_weight_path = RESULT_ROOT / \"best_by_ic_weight.csv\"\n\nif not completed_summary.empty:\n    best_result = completed_summary.loc[\n        [\n            completed_summary[\"relative_l2_error\"].idxmin()\n        ]\n    ].copy()\n\n    best_result[\"selection_rule\"] = (\n        \"Minimum relative L2 error among completed configurations \"\n        \"vs Python RK4\"\n    )\n\n    best_result[\"interpretation\"] = (\n        \"Best among tested configurations; \"\n        \"not an analytical-solution error\"\n    )\n\n    best_result.to_csv(\n        best_result_path,\n        index=False,\n    )\n\n    best_by_weight = (\n        completed_summary\n        .sort_values(\"relative_l2_error\")\n        .groupby(\"ic_weight\", as_index=False)\n        .first()\n    )\n\n    best_by_weight.to_csv(\n        best_by_weight_path,\n        index=False,\n    )\n\nelse:\n    best_result = pd.DataFrame()\n    best_by_weight = pd.DataFrame()\n\n    print(\n        \"No experiments completed successfully. \"\n        \"Check error_message in all_results.csv.\"\n    )\n\n\n# ---------------------------------------------------------------------------\n# Display final results\n# ---------------------------------------------------------------------------\nprint(\"\\nFINAL EXPERIMENT SUMMARY\")\n\nsummary_columns = [\n    \"experiment_id\",\n    \"status\",\n    \"epochs_per_window\",\n    \"neurons_per_layer\",\n    \"ic_weight\",\n    \"mae\",\n    \"mse\",\n    \"rmse\",\n    \"relative_l2_error\",\n    \"max_absolute_error\",\n    \"duration_seconds\",\n    \"best_overall\",\n    \"best_within_ic_weight\",\n    \"error_message\",\n]\n\ndisplay(final_summary[summary_columns])\n\nif not best_result.empty:\n    print(\n        \"\\nBest completed configuration overall \"\n        \"(relative L2 error vs Python RK4):\"\n    )\n\n    display(\n        best_result[\n            summary_columns\n            + [\"selection_rule\", \"interpretation\"]\n        ]\n    )\n\n    print(\n        \"\\nBest completed configuration for each IC weight:\"\n    )\n\n    display(\n        best_by_weight[\n            [\n                \"experiment_id\",\n                \"status\",\n                \"epochs_per_window\",\n                \"neurons_per_layer\",\n                \"ic_weight\