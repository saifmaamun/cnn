1/pinn_vs_rk4.png\n  /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW1/epochs_vs_loss.png\n\nLOG-E10000-N150-ICW1 -> /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW1\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW1/pinn_output.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW1/matlab_input.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW1/rk4_reference.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW1/epoch_loss.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW1/metrics.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW1/pinn_vs_rk4.png\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW1/epochs_vs_loss.png\n\nLOG-E1000-N50-ICW10 -> /kaggle/working/results/logistic_growth_1D/E1000_N50_ICW10\n  /kaggle/working/results/logistic_growth_1D/E1000_N50_ICW10/pinn_output.csv\n  /kaggle/working/results/logistic_growth_1D/E1000_N50_ICW10/matlab_input.csv\n  /kaggle/working/results/logistic_growth_1D/E1000_N50_ICW10/rk4_reference.csv\n  /kaggle/working/results/logistic_growth_1D/E1000_N50_ICW10/epoch_loss.csv\n  /kaggle/working/results/logistic_growth_1D/E1000_N50_ICW10/metrics.csv\n  /kaggle/working/results/logistic_growth_1D/E1000_N50_ICW10/pinn_vs_rk4.png\n  /kaggle/working/results/logistic_growth_1D/E1000_N50_ICW10/epochs_vs_loss.png\n\nLOG-E5000-N100-ICW10 -> /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW10\n  /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW10/pinn_output.csv\n  /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW10/matlab_input.csv\n  /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW10/rk4_reference.csv\n  /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW10/epoch_loss.csv\n  /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW10/metrics.csv\n  /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW10/pinn_vs_rk4.png\n  /kaggle/working/results/logistic_growth_1D/E5000_N100_ICW10/epochs_vs_loss.png\n\nLOG-E10000-N150-ICW10 -> /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW10\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW10/pinn_output.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW10/matlab_input.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW10/rk4_reference.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW10/epoch_loss.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW10/metrics.csv\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW10/pinn_vs_rk4.png\n  /kaggle/working/results/logistic_growth_1D/E10000_N150_ICW10/epochs_vs_loss.png\n\nCell 3 complete. Run Cell 4 to generate and display all plots.\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# ============================================================================\n# CELL 4 — ALL PLOTTING\n# Individual solution/error plots, local-epoch loss plots,\n# and the combined comparison plot for all completed experiments.\n# ============================================================================\n\n\n# ---------------------------------------------------------------------------\n# 1. Individual PINN-vs-RK4 solution and absolute-error plot\n# ---------------------------------------------------------------------------\ndef make_solution_plot(\n    t_eval,\n    x_pinn,\n    x_rk4,\n    errors,\n    epochs,\n    neurons,\n    ic_weight,\n    output_path,\n):\n    exp_id = make_experiment_id(\n        epochs, neurons, ic_weight\n    )\n\n    fig, axes = plt.subplots(\n        nrows=2,\n        ncols=1,\n        figsize=(11, 8),\n        sharex=True,\n        gridspec_kw={\"height_ratios\": [2, 1]},\n    )\n\n    axes[0].plot(\n        t_eval,\n        x_rk4,\n        color=\"black\",\n        linewidth=2.4,\n        label=\"Python RK4 reference\",\n    )\n\n    axes[0].plot(\n        t_eval,\n        x_pinn,\n        linestyle=\"--\",\n        linewidth=1.8,\n        label=\"PINN prediction\",\n    )\n\n    axes[0].set_ylabel(\"State x(t)\")\n    axes[0].set_title(\n        f\"{exp_id}\\n\"\n        f\"{EQUATION}; x(0)={INITIAL_X}, r={R}, K={K}\"\n    )\n    axes[0].grid(True, alpha=0.3)\n    axes[0].legend()\n\n    axes[1].plot(\n        t_eval,\n        np.abs(errors),\n        linewidth=1.5,\n        label=\"Absolute error\",\n    )\n\n    axes[1].set_xlabel(\"Time, t\")\n    axes[1].set_ylabel(\"|PINN - RK4|\")\n    axes[1].grid(True, alpha=0.3)\n    axes[1].legend()\n\n    fig.text(\n        0.5,\n        0.005,\n        f\"Architecture: 1-{neurons}x{HIDDEN_LAYERS}-1 | \"\n        f\"{ACTIVATION} | {OPTIMIZER_NAME}, lr={LEARNING_RATE} | \"\n        f\"IC weight={ic_weight} | windows={WINDOWS} | \"\n        f\"points/window={PHYSICS_POINTS} | seed={SEED}\",\n        ha=\"center\",\n        fontsize=8,\n    )\n\n    fig.tight_layout(rect=[0, 0.035, 1, 1])\n    fig.savefig(\n        output_path,\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    return fig\n\n\n# ---------------------------------------------------------------------------\n# 2. Five-panel local-epoch loss plot\n# Each window has an x-axis from epoch 1 to the configured epoch count.\n# ---------------------------------------------------------------------------\ndef make_local_epoch_loss_plot(\n    loss_history,\n    window_edges,\n    epochs,\n    neurons,\n    ic_weight,\n    output_path,\n):\n    exp_id = make_experiment_id(\n        epochs, neurons, ic_weight\n    )\n\n    loss_df = pd.DataFrame(\n        loss_history,\n        columns=[\n            \"global_step\",\n            \"window\",\n            \"epoch_in_window\",\n            \"physics_loss\",\n            \"ic_loss\",\n            \"total_loss\",\n        ],\n    )\n\n    fig, axes = plt.subplots(\n        nrows=WINDOWS,\n        ncols=1,\n        figsize=(12, max(12, 2.7 * WINDOWS)),\n        sharex=True,\n    )\n\n    axes = np.atleast_1d(axes)\n    tiny = np.finfo(np.float64).tiny\n\n    for window_number, ax in enumerate(\n        axes, start=1\n    ):\n        window_df = loss_df[\n            loss_df[\"window\"] == window_number\n        ].sort_values(\"epoch_in_window\")\n\n        if window_df.empty:\n            ax.set_title(\n                f\"Window {window_number}: no recorded loss\"\n            )\n            continue\n\n        local_epochs = window_df[\n            \"epoch_in_window\"\n        ].to_numpy()\n\n        physics_loss = window_df[\n            \"physics_loss\"\n        ].to_numpy()\n\n        # The plotted IC curve is the contribution to total loss.\n        weighted_ic_loss = (\n            ic_weight * window_df[\"ic_loss\"].to_numpy()\n        )\n\n        total_loss = window_df[\n            \"total_loss\"\n        ].to_numpy()\n\n        ax.plot(\n            local_epochs,\n            np.maximum(total_loss, tiny),\n            color=\"tab:blue\",\n            linewidth=1.4,\n            label=\"Total loss\",\n        )\n\n        ax.plot(\n            local_epochs,\n            np.maximum(physics_loss, tiny),\n            color=\"tab:orange\",\n            linestyle=\"--\",\n            linewidth=1.2,\n            label=\"Physics loss\",\n        )\n\n        ax.plot(\n            local_epochs,\n            np.maximum(weighted_ic_loss, tiny),\n            color=\"tab:green\",\n            linestyle=\"-.\",\n            linewidth=1.2,\n            label=\"Weighted IC contribution\",\n        )\n\n        t_start = window_edges[window_number - 1]\n        t_end = window_edges[window_number]\n\n        ax.set_title(\n            f\"Window {window_number}: \"\n            f\"t = {t_start:.2f} to {t_end:.2f}\",\n            loc=\"left\",\n            fontsize=10,\n        )\n\n        ax.set_ylabel(\"Loss (log scale)\")\n        ax.set_yscale(\"log\")\n        ax.set_xlim(1, epochs)\n        ax.grid(True, which=\"both\", alpha=0.25)\n        ax.legend(\n            loc=\"best\",\n            fontsize=8,\n            ncol=3,\n        )\n\n    axes[-1].set_xlabel(\n        \"Epoch within the current window\"\n    )\n\n    fig.suptitle(\n        f\"{exp_id} | Training loss vs local epoch\\n\"\n        \"The epoch axis restarts at 1 for each window\",\n        fontsize=13,\n        y=1.002,\n    )\n\n    fig.tight_layout()\n    fig.savefig(\n        output_path,\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    return fig\n\n\n# ---------------------------------------------------------------------------\n# 3. One combined plot: shared RK4 reference and every completed PINN\n# ---------------------------------------------------------------------------\ndef make_combined_plot(\n    completed_runs,\n    output_path,\n):\n    if not completed_runs:\n        return None\n\n    fig, axes = plt.subplots(\n        nrows=2,\n        ncols=1,\n        figsize=(13, 9),\n        sharex=True,\n        gridspec_kw={\"height_ratios\": [2, 1]},\n    )\n\n    first_run = completed_runs[0]\n\n    axes[0].plot(\n        first_run[\"time\"],\n        first_run[\"rk4\"],\n        color=\"black\",\n        linewidth=3.0,\n        label=\"Python RK4 reference\",\n        zorder=10,\n    )\n\n    palette = plt.get_cmap(\"tab10\")\n\n    for index, run in enumerate(completed_runs):\n        color = palette(index % 10)\n        label = run[\"experiment_id\"]\n\n        axes[0].plot(\n            run[\"time\"],\n            run[\"pinn\"],\n            color=color,\n            linewidth=1.4,\n            linestyle=\"--\",\n            label=label,\n        )\n\n        axes[1].plot(\n            run[\"time\"],\n            np.abs(run[\"error\"]),\n            color=color,\n            linewidth=1.3,\n            label=label,\n        )\n\n    axes[0].set_ylabel(\"State x(t)\")\n    axes[0].set_title(\n        \"All completed PINN configurations vs Python RK4\"\n    )\n    axes[0].grid(True, alpha=0.3)\n    axes[0].legend(\n        fontsize=8,\n        ncol=2,\n    )\n\n    axes[1].set_xlabel(\"Time, t\")\n    axes[1].set_ylabel(\"Absolute error\")\n    axes[1].grid(True, alpha=0.3)\n    axes[1].legend(\n        fontsize=8,\n        ncol=2,\n    )\n\n    fig.tight_layout()\n    fig.savefig(\n        output_path,\n        dpi=200,\n        bbox_inches=\"tight\",\n    )\n\n    return fig\n\n\n# ---------------------------------------------------------------------------\n# 4. Read saved files and generate all figures\n# ---------------------------------------------------------------------------\nif not SUMMARY_CSV.exists():\n    raise FileNotFoundError(\n        f\"{SUMMARY_CSV} not found. Run Cell 3 before Cell 4.\"\n    )\n\nplot_summary = pd.read_csv(SUMMARY_CSV)\n\ncompleted_plot_summary = plot_summary[\n    plot_summary[\"status\"] == \"completed\"\n].copy()\n\ncompleted_runs_for_plot = []\n\nfor _, row in completed_plot_summary.iterrows():\n    epochs = int(row[\"epochs_per_window\"])\n    neurons = int(row[\"neurons_per_layer\"])\n    ic_weight = float(row[\"ic_weight\"])\n    exp_root = Path(row[\"experiment_folder\"])\n\n    pinn_path = exp_root / \"pinn_output.csv\"\n    rk4_path = exp_root / \"rk4_reference.csv\"\n    loss_path = exp_root / \"epoch_loss.csv\"\n\n    missing = [\n        str(path)\n        for path in (pinn_path, rk4_path, loss_path)\n        if not path.exists()\n    ]\n\n    if missing:\n        print(\n            f\"Skipping {row['experiment_id']}; \"\n            f\"missing files: {missing}\"\n        )\n        continue\n\n    pinn_df = pd.read_csv(pinn_path)\n    rk4_df = pd.read_csv(rk4_path)\n    loss_df = pd.read_csv(loss_path)\n\n    # Match PINN and RK4 rows by time rather than assuming row positions.\n    comparison = pinn_df[\n        [\"time\", \"pinn_x\"]\n    ].merge(\n        rk4_df[[\"time\", \"rk4_x\"]],\n        on=\"time\",\n        how=\"inner\",\n        validate=\"one_to_one\",\n    )\n\n    if len(comparison) != TEST_POINTS:\n        print(\n            f\"Skipping {row['experiment_id']}: expected \"\n            f\"{TEST_POINTS} matching time points, \"\n            f\"found {len(comparison)}.\"\n        )\n        continue\n\n    t_eval = comparison[\"time\"].to_numpy(dtype=float)\n    x_pinn = comparison[\"pinn_x\"].to_numpy(dtype=float)\n    x_rk4 = comparison[\"rk4_x\"].to_numpy(dtype=float)\n    errors = x_pinn - x_rk4\n\n    # Individual trajectory/reference/error plot.\n    solution_path = exp_root / \"pinn_vs_rk4.png\"\n\n    fig = make_solution_plot(\n        t_eval,\n        x_pinn,\n        x_rk4,\n        errors,\n        epochs,\n        neurons,\n        ic_weight,\n        solution_path,\n    )\n\n    display(fig)\n    plt.close(fig)\n\n    # The loss CSV contains additional metadata columns. Select just the\n    # six columns needed by the plotting helper.\n    history_array = loss_df[\n        [\n            \"global_step\",\n            \"window\",\n            \"epoch_in_window\",\n            \"physics_loss\",\n            \"ic_loss\",\n            \"total_loss\",\n        ]\n    ].to_numpy().tolist()\n\n    loss_plot_path = exp_root / \"epochs_vs_loss.png\"\n\n    fig = make_local_epoch_loss_plot(\n        history_array,\n        np.linspace(\n            0.0,\n            TOTAL_TIME,\n            WINDOWS + 1,\n        ),\n        epochs,\n        neurons,\n        ic_weight,\n        loss_plot_path,\n    )\n\n    display(fig)\n    plt.close(fig)\n\n    completed_runs_for_plot.append({\n        \"experiment_id\": row[\"experiment_id\"],\n        \"time\": t_eval,\n        \"pinn\": x_pinn,\n        \"rk4\": x_rk4,\n        \"error\": errors,\n    })\n\n\n# ---------------------------------------------------------------------------\n# 5. Combined plot across all successful experiments\n# ---------------------------------------------------------------------------\ncombined_fig = make_combined_plot(\n    completed_runs_for_plot,\n    COMBINED_PLOT,\n)\n\nif combined_fig is not None:\n    display(combined_fig)\n    plt.close(combined_fig)\nelse:\n    print(\n        \"No completed experiment folders were available to plot.\"\n    )\n\nprint(\n    f\"\\nIndividual and combined plots saved under: {RESULT_ROOT}\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-13T11:46:12.295313Z","iopub.execute_input":"2026-10-13T11:46:12.295661Z","iopub.status.idle":"2026-10-13T11:46:34.83379Z","shell.execute_reply.started":"2026-10-13T11:46:12.295638Z","shell.execute_reply":"2026-10-13T11:46:34.832832Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1350 with 5 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1350 with 5 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1350 with 5 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1350 with 5 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1350 with 5 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x800 with 2 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1350 with 5 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Fi