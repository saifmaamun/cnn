 \"rk4\": x_rk4.copy(),\n        \"error\": error.copy(),\n    }\n\n    print(\n        f\"Completed {exp_id} in \"\n        f\"{duration_seconds / 60.0:.1f} minutes.\"\n    )\n\n    print(\"Metrics:\")\n    display(pd.DataFrame([{\n        \"experiment_id\": exp_id,\n        \"epochs_per_window\": epochs,\n        \"neurons_per_layer\": neurons,\n        \"ic_weight\": ic_weight,\n        \"MAE\": mae,\n        \"MSE\": mse,\n        \"RMSE\": rmse,\n        \"relative_L2_error_vs_RK4\": relative_l2,\n        \"maximum_absolute_error\": max_error,\n        \"duration_minutes\": duration_seconds / 60.0,\n    }]))\n\n    print(\"Solution vs RK4 and absolute error:\")\n    display(Image(filename=str(solution_path)))\n\n    print(\n        \"Training progress: local epoch on x-axis, \"\n        \"separate panel per window:\"\n    )\n    display(Image(filename=str(loss_plot_path)))\n\n    return result, combined_plot_record\n\n\n# ---------------------------------------------------------------------------\n# 7. Initialize output directory and run all six configurations\n# ---------------------------------------------------------------------------\nif RESET_OUTPUT_DIRECTORY and RESULT_ROOT.exists():\n    shutil.rmtree(RESULT_ROOT)\n\nRESULT_ROOT.mkdir(parents=True, exist_ok=True)\n\nif MASTER_CSV.exists():\n    MASTER_CSV.unlink()\n\n# Save a status row for every experiment before training begins.\nsummary_rows = []\n\nfor epochs, neurons, ic_weight in CONFIGS:\n    row = metadata(\n        epochs, neurons, ic_weight, \"experiment_summary\"\n    )\n    row.update({\n        \"status\": \"pending\",\n        \"error_message\": \"\",\n        \"duration_seconds\": np.nan,\n        \"mae\": np.nan,\n        \"mse\": np.nan,\n        \"rmse\": np.nan,\n        \"relative_l2_error\": np.nan,\n        \"max_absolute_error\": np.nan,\n        \"selection_metric\": \"relative_l2_error_vs_Python_RK4\",\n        \"experiment_folder\": str(\n            RESULT_ROOT\n            / make_folder_name(epochs, neurons, ic_weight)\n        ),\n        \"solution_plot\": \"\",\n        \"loss_plot\": \"\",\n    })\n    summary_rows.append(row)\n\nwrite_summary(summary_rows)\n\ntotal_updates = sum(\n    epochs * WINDOWS\n    for epochs, _, _ in CONFIGS\n)\n\nprogress_handle = display(\n    \"Starting PINN experiment suite...\",\n    display_id=True,\n)\n\nprogress_state = {\n    \"updates_done\": 0,\n    \"display_handle\": progress_handle,\n}\n\ncompleted_runs = []\n\nprint(f\"Planned experiments: {len(CONFIGS)}\")\nprint(f\"Total optimizer updates: {total_updates:,}\")\nprint(f\"Output directory: {RESULT_ROOT}\")\nprint(\"Master CSV is checkpointed after every completed time window.\")\n\nfor config_index, (epochs, neurons, ic_weight) in enumerate(CONFIGS):\n    exp_id = make_experiment_id(epochs, neurons, ic_weight)\n    start_time = time.time()\n\n    # Persist status before starting the potentially long training run.\n    summary_rows[config_index][\"status\"] = \"running\"\n    summary_rows[config_index][\"error_message\"] = \"\"\n    write_summary(summary_rows)\n\n    try:\n        result, plot_record = run_experiment(\n            epochs,\n            neurons,\n            ic_weight,\n            progress_state,\n            total_updates,\n        )\n\n        summary_rows[config_index].update(result)\n        summary_rows[config_index][\"status\"] = \"completed\"\n        summary_rows[config_index][\"error_message\"] = \"\"\n        completed_runs.append(plot_record)\n\n    except Exception as exc:\n        # Preserve previously checkpointed windows and continue to the\n        # next configuration instead of abandoning the entire experiment.\n        summary_rows[config_index][\"status\"] = \"failed\"\n        summary_rows[config_index][\"error_message\"] = (\n            f\"{type(exc).__name__}: {exc}\"\n        )\n        summary_rows[config_index][\"duration_seconds\"] = (\n            time.time() - start_time\n        )\n        print(\