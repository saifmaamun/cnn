oat32\n    )\n\n    # --------------------------------------------------------\n    # DenseNet121 ImageNet preprocessing\n    # --------------------------------------------------------\n\n    image = preprocess_input(\n        image\n    )\n\n    return image, label","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T18:29:31.507754Z","iopub.execute_input":"2026-09-03T18:29:31.508141Z","iopub.status.idle":"2026-09-03T18:29:31.517868Z","shell.execute_reply.started":"2026-09-03T18:29:31.508105Z","shell.execute_reply":"2026-09-03T18:29:31.517237Z"}},"outputs":[],"execution_count":15},{"cell_type":"markdown","source":"**BUILD DATASET**","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# 14 — BUILD TF.DATA DATASETS\n# ============================================================\n\ndef create_dataset(\n    dataframe,\n    targets,\n    batch_size=BATCH_SIZE,\n    shuffle=False\n):\n    \"\"\"\n    Create a tf.data pipeline from a dataframe\n    and its multi-label targets.\n    \"\"\"\n\n    paths = dataframe[\"image_path\"].to_numpy()\n\n    targets = targets.astype(\n        np.float32\n    )\n\n\n    # --------------------------------------------------------\n    # Create dataset\n    # --------------------------------------------------------\n\n    dataset = tf.data.Dataset.from_tensor_slices(\n        (\n            paths,\n            targets\n        )\n    )\n\n\n    # --------------------------------------------------------\n    # Shuffle training data only\n    # --------------------------------------------------------\n\n    if shuffle:\n\n        dataset = dataset.shuffle(\n            buffer_size=len(dataframe),\n            seed=SEED,\n            reshuffle_each_iteration=True\n        )\n\n\n    # --------------------------------------------------------\n    # Load + preprocess images\n    # --------------------------------------------------------\n\n    dataset = dataset.map(\