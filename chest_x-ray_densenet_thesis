n_count":21},{"cell_type":"code","source":"# ============================================================\n# 17 — DENSE BLOCK\n# ============================================================\n\ndef dense_block(\n    x,\n    repetitions,\n    growth_rate=GROWTH_RATE\n):\n    \"\"\"\n    Stack multiple DenseNet bottleneck layers.\n\n    Each bottleneck adds `growth_rate` feature maps.\n    \"\"\"\n\n    for _ in range(repetitions):\n\n        x = bottleneck_layer(\n            x,\n            growth_rate=growth_rate\n        )\n\n    return x","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-26T07:29:58.666036Z","iopub.execute_input":"2026-08-26T07:29:58.666356Z","iopub.status.idle":"2026-08-26T07:29:58.678625Z","shell.execute_reply.started":"2026-08-26T07:29:58.666305Z","shell.execute_reply":"2026-08-26T07:29:58.678026Z"}},"outputs":[],"execution_count":22},{"cell_type":"code","source":"# ============================================================\n# 18 — TRANSITION LAYER\n# ============================================================\n\ndef transition_layer(\n    x,\n    compression=0.5\n):\n    \"\"\"\n    DenseNet transition layer.\n\n    BN → ReLU → 1×1 Conv → Average Pooling\n    \"\"\"\n\n    x = layers.BatchNormalization()(x)\n\n    x = layers.ReLU()(x)\n\n\n    # Current number of channels\n    channels = x.shape[-1]\n\n    if channels is None:\n        raise ValueError(\n            \"Channel dimension must be known \"\n            \"before the transition layer.\"\n        )\n\n\n    # Compress feature maps\n    filters = int(\n        channels * compression\n    )\n\n    x = layers.Conv2D(\n        filters=filters,\n        kernel_size=1,\n        strides=1,\n        padding=\"same\",\n        use_bias=False\n    )(x)\n\n\n    # Downsample spatial dimensions\n    x = layers.AveragePooling2D(\n        pool_size=2,\n        strides=2,\n        padding=\"same\"\n    )(x)\n\n    return x","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-26T07:29:58.679466Z","iopub.execute_input":"2026-08-26T07:29:58.679733Z","iopub.status.idle":"2026-08-26T07:29:58.690268Z","shell.execute_reply.started":"2026-08-26T07:29:58.679705Z","shell.execute_reply":"2026-08-26T07:29:58.689554Z"}},"outputs":[],"execution_count":23},{"cell_type":"code","source":"# ============================================================\n# 19 — BUILD CUSTOM DENSENET121\n# BASELINE ARCHITECTURE\n# ============================================================\n\ndef build_research_densenet(\n    input_shape,\n    num_classes,\n    growth_rate=GROWTH_RATE,\n    attention_config=None,\n    dropout_rate=DROPOUT_RATE\n):\n    \"\"\"\n    Build the custom DenseNet-121 architecture.\n\n    Dense block configuration:\n        6 → 12 → 24 → 16\n\n    This is the baseline architecture.\n    Attention is disabled unless explicitly implemented\n    and configured.\n    \"\"\"\n\n    inputs = layers.Input(\n        shape=input_shape,\n        name=\"image_input\"\n    )\n\n\n    # ========================================================\n    # INITIAL STEM\n    # ========================================================\n\n    x = layers.Conv2D(\n        filters=64,\n        kernel_size=7,\n        strides=2,\n        padding=\"same\",\n        use_bias=False,\n        name=\"initial_conv\"\n    )(inputs)\n\n    x = layers.BatchNormalization(\n        name=\"initial_bn\"\n    )(x)\n\n    x = layers.ReLU(\n        name=\"initial_relu\"\n    )(x)\n\n    x = layers.MaxPooling2D(\n        pool_size=3,\n        strides=2,\n        padding=\"same\",\n        name=\"initial_pool\"\n    )(x)\n\n\n    # ========================================================\n    # DENSE BLOCK 1 — 6 LAYERS\n    # ========================================================\n\n    x = dense_block(\n        x,\n        repetitions=6,\n        growth_rate=growth_rate\n    )\n\n\n    # ========================================================\n    # TRANSITION 1\n    # ========================================================\n\n    x = transition_layer(x)\n\n\n    # ========================================================\n    # DENSE BLOCK 2 — 12 LAYERS\n    # ========================================================\n\n    x = dense_block(\n        x,\n        repetitions=12,\n        growth_rate=growth_rate\n    )\n\n\n    # ========================================================\n    # TRANSITION 2\n    # ========================================================\n\n    x = transition_layer(x)\n\n\n    # ========================================================\n    # DENSE BLOCK 3 — 24 LAYERS\n    # ========================================================\n\n    x = dense_block(\n        x,\n        repetitions=24,\n        growth_rate=growth_rate\n    )\n\n\n    # ========================================================\n    # TRANSITION 3\n    # ========================================================\n\n    x = transition_layer(x)\n\n\n    # ========================================================\n    # DENSE BLOCK 4 — 16 LAYERS\n    # ========================================================\n\n    x = dense_block(\n        x,\n        repetitions=16,\n        growth_rate=growth_rate\n    )\n\n\n    # ========================================================\n    # FINAL NORMALIZATION\n    # ========================================================\n\n    x = layers.BatchNormalization(\n        name=\"final_bn\"\n    )(x)\n\n    x = layers.ReLU(\n        name=\"final_relu\"\n    )(x)\n\n\n    # ========================================================\n    # CLASSIFICATION HEAD\n    # ========================================================\n\n    x = layers.GlobalAveragePooling2D(\n        name=\"global_average_pooling\"\n    )(x)\n\n    x = layers.Dropout(\n        dropout_rate,\n        name=\"classifier_dropout\"\n    )(x)\n\n\n    # ========================================================\n    # MULTI-LABEL OUTPUT\n    # ========================================================\n\n    outputs = layers.Dense(\n        num_classes,\n        activation=\"sigmoid\",\n        name=\"classifier\"\n    )(x)\n\n\n    # ========================================================\n    # MODEL\n    # ========================================================\n\n    model = keras.Model(\n        inputs=inputs,\n        outputs=outputs,\n        name=MODEL_NAME\n    )\n\n    return model","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-26T07:29:58.691455Z","iopub.execute_input":"2026-08-26T07:29:58.691777Z","iopub.status.idle":"2026-08-26T07:29:58.705187Z","shell.execute_reply.started":"2026-08-26T07:29:58.691747Z","shell.execute_reply":"2026-08-26T07:29:58.704412Z"}},"outputs":[],"execution_count":24},{"cell_type":"markdown","source":"# plot figure\n","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# 20 — NIH IMAGE VISUALIZATION\n# ============================================================\n\ndef show_batch(\n    images,\n    labels,\n    class_names,\n    n=16,\n    columns=4\n):\n    \"\"\"\n    Display a batch of chest X-ray images with their\n    corresponding multi-label findings.\n    \"\"\"\n\n    n = min(\n        n,\n        len(images)\n    )\n\n    rows = int(\n        np.ceil(n / columns)\n    )\n\n    plt.figure(\n        figsize=(\n            columns * 4,\n            rows * 4\n        )\n    )\n\n    for i in range(n):\n\n        plt.subplot(\n            rows,\n            columns,\n            i + 1\n        )\n\n        plt.imshow(\n            images[i]\n        )\n\n        positive_labels = [\n            class_names[j]\n            for j in range(len(class_names))\n            if labels[i][j] == 1\n        ]\n\n        title = (\n            \"No Finding\"\n            if not positive_labels\n            else \", \".join(positive_labels)\n        )\n\n        plt.title(\n            title,\n         