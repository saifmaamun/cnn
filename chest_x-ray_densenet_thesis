03.407836Z","iopub.status.idle":"2026-08-25T17:20:03.421945Z","shell.execute_reply.started":"2026-08-25T17:20:03.407807Z","shell.execute_reply":"2026-08-25T17:20:03.421128Z"},"jupyter":{"source_hidden":true}},"outputs":[],"execution_count":22},{"cell_type":"markdown","source":"\n==========================================\n\n***DenseNet***\n\n==========================================\n","metadata":{}},{"cell_type":"code","source":"# ==========================================\n# CUSTOM DENSENET121\n# BASELINE ARCHITECTURE\n# ==========================================\n\n# ==========================================\n# Bottleneck Layer\n# ==========================================\n\ndef bottleneck_layer(\n    x,\n    filters,\n    strides=1\n):\n\n    skip_connection = x\n\n    # BN → ReLU → Conv 1×1\n    x = layers.BatchNormalization()(x)\n\n    x = layers.ReLU()(x)\n\n    x = layers.Conv2D(\n        4 * filters,\n        kernel_size=1,\n        strides=strides,\n        padding=\"same\",\n        use_bias=False\n    )(x)\n\n    # BN → ReLU → Conv 3×3\n    x = layers.BatchNormalization()(x)\n\n    x = layers.ReLU()(x)\n\n    x = layers.Conv2D(\n        filters,\n        kernel_size=3,\n        strides=1,\n        padding=\"same\",\n        use_bias=False\n    )(x)\n\n    # Dense connectivity\n    x = layers.Concatenate()(\n        [x, skip_connection]\n    )\n\n    return x\n\n\n# ==========================================\n# Transition Layer\n# ==========================================\n\ndef transition_layer(x):\n\n    x = layers.BatchNormalization()(x)\n\n    x = layers.ReLU()(x)\n\n    x = layers.Conv2D(\n        keras.backend.int_shape(x)[-1] // 2,\n        kernel_size=1,\n        strides=1,\n        padding=\"same\",\n        use_bias=False\n    )(x)\n\n    x = layers.AvgPool2D(\n        pool_size=2,\n        strides=2,\n        padding=\"same\"\n    )(x)\n\n    return x\n\n\n# ==========================================\n# Dense Block\n# ==========================================\n\ndef dense_block(\n    x,\n    repetition=1,\n    growth_rate=32\n):\n\n    for _ in range(repetition):\n\n        x = bottleneck_layer(\n            x,\n            growth_rate\n        )\n\n    return x","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-25T17:20:03.423046Z","iopub.execute_input":"2026-08-25T17:20:03.423385Z","iopub.status.idle":"2026-08-25T17:20:03.436996Z","shell.execute_reply.started":"2026-08-25T17:20:03.423351Z","shell.execute_reply":"2026-08-25T17:20:03.435997Z"}},"outputs":[],"execution_count":23},{"cell_type":"code","source":"# ==========================================\n# BUILD CUSTOM DENSENET121\n# BASELINE\n# ==========================================\n\ndef build_research_densenet(\n    input_shape,\n    num_classes,\n    growth_rate=32,\n    attention_config=None\n):\n\n    inputs = layers.Input(\n        shape=input_shape,\n        name=\"image_input\"\n    )\n\n    # ==========================================\n    # Initial Stem\n    # ==========================================\n\n    x = layers.Conv2D(\n        64,\n        kernel_size=7,\n        strides=2,\n        padding=\"same\",\n        use_bias=False,\n        name=\"initial_conv\"\n    )(inputs)\n\n    x = layers.BatchNormalization(\n        name=\"initial_bn\"\n    )(x)\n\n    x = layers.ReLU(\n        name=\"initial_relu\"\n    )(x)\n\n    x = layers.MaxPooling2D(\n        pool_size=3,\n        strides=2,\n        padding=\"same\",\n        name=\"initial_pool\"\n    )(x)\n\n    # ==========================================\n    # Dense Block 1\n    # ==========================================\n\n    x = dense_block(\n        x,\n        repetition=6,\n        growth_rate=growth_rate\n    )\n\n    # ==========================================\n    # Transition 1\n    # ==========================================\n\n    x = transition_layer(x)\n\n    # ==========================================\n    # Dense Block 2\n    # ==========================================\n\n    x = dense_block(\n        x,\n        repetition=12,\n        growth_rate=growth_rate\n    )\n\n    # ==========================================\n    # Transition 2\n    # ==========================================\n\n    x = transition_layer(x)\n\n    # ==========================================\n    # Dense Block 3\n    # ==========================================\n\n    x = dense_block(\n        x,\n        repetition=24,\n        growth_rate=growth_rate\n    )\n\n    # ==========================================\n    # Transition 3\n    # ==========================================\n\n    x = transition_layer(x)\n\n    # ==========================================\n    # Dense Block 4\n    # ==========================================\n\n    x = dense_block(\n        x,\n        repetition=16,\n        growth_rate=growth_rate\n    )\n\n    # ==========================================\n    # Final Normalization\n    # ==========================================\n\n    x = layers.BatchNormalization(\n        name=\"final_bn\"\n    )(x)\n\n    x = layers.ReLU(\n        name=\"final_relu\"\n    )(x)\n\n    # ==========================================\n    # Classification Head\n    # ==========================================\n\n    x = layers.GlobalAveragePooling2D(\n        name=\"global_average_pooling\"\n    )(x)\n\n    x = layers.Dropout(\n        0.5,\n        name=\"classifier_dropout\"\n    )(x)\n\n    # ==========================================\n    # MULTI-LABEL OUTPUT\n    # ==========================================\n\n    outputs = layers.Dense(\n        num_classes,\n        activation=\"sigmoid\",\n        name=\"classifier\"\n    )(x)\n\n    # ==========================================\n    # Model\n    # ==========================================\n\n    model = keras.Model(\n        inputs=inputs,\n        outputs=outputs,\n        name=\"CustomDenseNet121\"\n    )\n\n    return model","metadata":{"trusted":true,"ex