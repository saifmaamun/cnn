 3)\n               with values in [0, 1]\n\n        label: multi-label target vector\n    \"\"\"\n\n    # --------------------------------------------------------\n    # Read image\n    # --------------------------------------------------------\n\n    image = tf.io.read_file(\n        image_path\n    )\n\n    # --------------------------------------------------------\n    # Decode PNG\n    # --------------------------------------------------------\n\n    image = tf.image.decode_png(\n        image,\n        channels=3\n    )\n\n    # --------------------------------------------------------\n    # Resize\n    # --------------------------------------------------------\n\n    image = tf.image.resize(\n        image,\n        IMAGE_SIZE\n    )\n\n    # --------------------------------------------------------\n    # Convert uint8 → float32 and scale to [0, 1]\n    # --------------------------------------------------------\n\n    image = tf.image.convert_image_dtype(\n        image,\n        dtype=tf.float32\n    )\n\n    # Normalize pixels from [0, 255] → [0, 1]\n    image = image / 255.0\n\n    return image, label","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-26T07:29:55.815777Z","iopub.execute_input":"2026-08-26T07:29:55.816131Z","iopub.status.idle":"2026-08-26T07:29:55.822061Z","shell.execute_reply.started":"2026-08-26T07:29:55.816104Z","shell.execute_reply":"2026-08-26T07:29:55.820871Z"}},"outputs":[],"execution_count":14},{"cell_type":"markdown","source":"**BUILD DATASET**","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# 14 — BUILD TF.DATA DATASETS\n# ============================================================\n\ndef create_dataset(\n    dataframe,\n    targets,\n    batch_size=BATCH_SIZE,\n    shuffle=False\n):\n    \"\"\"\n    Create a tf.data pipeline from a dataframe\n    and its multi-label targets.\n    \"\"\"\n\n    paths = dataframe[\"image_path\"].to_numpy()\n\n    targets = targets.astype(\n        np.float32\n    )\n\n\n    # --------------------------------------------------------\n    # Create dataset\n    # --------------------------------------------------------\n\n    dataset = tf.data.Dataset.from_tensor_slices(\n        (\n            paths,\n            targets\n        )\n    )\n\n\n    # --------------------------------------------------------\n    # Shuffle training data only\n    # --------------------------------------------------------\n\n    if shuffle:\n\n        dataset = dataset.shuffle(\n            buffer_size=len(dataframe),\n            seed=SEED,\n            reshuffle_each_iteration=True\n        )\n\n\n    # --------------------------------------------------------\n    # Load + preprocess images\n    # --------------------------------------------------------\n\n    dataset = dataset.map(\n        load_and_preprocess_image,\n        num_parallel_calls=AUTOTUNE\n    )\n\n\n    # --------------------------------------------------------\n    # Batch\n    # --------------------------------------------------------\n\n    dataset = dataset.batch(\n        batch_size,\n        drop_remainder=False\n    )\n\n\n    # --------------------------------------------------------\n    # Prefetch\n    # --------------------------------------------------------\n\n    dataset = dataset.prefetch(\n        AUTOTUNE\n    )\n\n    return dataset\n\n\n# ============================================================\n# CREATE SPLIT DATASETS\n# ============================================================\n\ntrain_ds = create_dataset(\n    train_df,\n    Y_train,\n    shuffle=True\n)\n\nval_ds = create_dataset(\n    val_df,\n    Y_val,\n    shuffle=False\n)\n\ntest_ds = create_dataset(\n    test_df,\n    Y_test,\n    shuffle=False\n)\n\n\n# ============================================================\n# DATASET VERIFICATION\n# ============================================================\n\nprint(\"=\" * 60)\nprint(\"TF.DATA DATASETS\