{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.6.6","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import os,random,numpy as np,pandas as pd,tensorflow as tf,matplotlib.pyplot as plt\nfrom pathlib import Path\nfrom IPython.display import display,Image\n\n# Set reproducibility\nSEED=42\nnp.random.seed(SEED)\nrandom.seed(SEED)\ntf.random.set_seed(SEED)\n\n# Define the experiment configurations\nEPOCHS=[1000,5000,10000]\nNEURONS=[50,100,150]\nCONFIGS=list(zip(EPOCHS,NEURONS))\n\n# Define the fixed PINN settings\nTOTAL_TIME=1.0\nWINDOWS=5\nPHYSICS_POINTS=100\nTEST_POINTS=500\nHIDDEN_LAYERS=3\nLEARNING_RATE=0.001\nIC_WEIGHT=1.0\n\n# Define the result directory\nRESULT_ROOT=Path(\"/kaggle/working/results/2D\")\n\n# Define the 2D benchmark equations\nPROBLEMS=[\n{\"id\":\"E3\",\"dimension\":\"2D\",\"type\":\"Linear\",\"source\":\"Ross Ch. 7, Sec. 7.3, Problem 2\",\"equation\":\"x'=5x+3y, y'=4x+y\",\"ic\":\"x(0)=8, y(0)=0\",\"initial\":[8.0,0.0]},\n{\"id\":\"E4\",\"dimension\":\"2D\",\"type\":\"Nonlinear\",\"source\":\"Ross Ch. 13.4, Problem 1\",\"equation\":\"x'=4x-4y-x(x^2+y^2), y'=4x+4y-y(x^2+y^2)\",\"ic\":\"x(0)=1, y(0)=0\",\"initial\":[1.0,0.0]}\n]\n\n# Build the PINN with three hidden Tanh layers\ndef build_model(neurons):\n    layers=[tf.keras.layers.Input(shape=(1,))]\n    for _ in range(HIDDEN_LAYERS):\n        layers.append(tf.keras.layers.Dense(neurons,activation=\"tanh\"))\n    layers.append(tf.keras.layers.Dense(2,activation=\"linear\"))\n    return tf.keras.Sequential(layers)\n\n# Define the right-hand side of each ODE system\ndef rhs(t,state,problem_id):\n    t=tf.cast(t,tf.float32)\n    x=state[:,0:1]\n    y=state[:,1:2]\n    if problem_id==\"E3\":\n        dx=5.0*x+3.0*y\n        dy=4.0*x+y\n    else:\n        r2=tf.square(x)+tf.square(y)\n        dx=4.0*x-4.0*y-x*r2\n        dy=4.0*x+4.0*y-y*r2\n    return tf.concat([dx,dy],axis=1)\n\n# Calculate the physics residual using automatic differentiation\ndef physics_residual(model,t,problem_id):\n    t=tf.cast(t,tf.float32)\n    with tf.GradientTape(persistent=True) as tape:\n        tape.watch(t)\n        state=model(t,training=True)\n        x=state[:,0:1]\n        y=state[:,1:2]\n    dx_dt=tape.gradient(x,t)\n    dy_dt=tape.gradient(y,t)\n    del tape\n    derivatives=tf.concat([dx_dt,dy_dt],axis=1)\n    return derivatives-rhs(t,state,problem_id)\n\n# Solve the 2D system independently using RK4\ndef rk4_solution(t,problem_id,y0):\n    t=np.asarray(t,dtype=np.float64).flatten()\n    solution=np.zeros((len(t),2),dtype=np.float64)\n    solution[0]=y0\n\n    def f(tv,state):\n        x,y=state\n        if problem_id==\"E3\":\n            return np.array([5*x+3*y,4*x+y],dtype=np.float64)\n        r2=x*x+y*y\n        return np.array([4*x-4*y-x*r2,4*x+4*y-y*r2],dtype=np.float64)\n\n    for i in range(len(t)-1):\n        h=t[i+1]-t[i]\n        ti=t[i]\n        yi=solution[i]\n        k1=f(ti,yi)\n        k2=f(ti+h/2,yi+h*k1/2)\n        k3=f(ti+h/2,yi+h*k2/2)\n        k4=f(ti+h,yi+h*k3)\n        solution[i+1]=yi+(h/6)*(k1+2*k2+2*k3+k4)\n\n    return solution\n\n# Add experiment metadata to every CSV\ndef add_metadata(df,problem,epochs,neurons):\n    metadata={\n        \"equation\":problem[\"equation\"],\n        \"dimension\":problem[\"dimension\"],\n        \"problem_type\":problem[\"type\"],\n        \"source\":problem[\"source\"],\n        \"problem_id\":problem[\"id\"],\n        \"initial_condition\":problem[\"ic\"],\n        \"epochs\":epochs,\n        \"neurons\":neurons,\n        \"hidden_layers\":HIDDEN_LAYERS,\n        \"activation\":\"Tanh\",\n        \"learning_rate\":LEARNING_RATE,\n        \"ic_weight\":IC_WEIGHT,\n        \"time_horizon\":TOTAL_TIME,\n        \"windows\":WINDOWS,\n        \"collocation_points\":PHYSICS_POINTS,\n        \"test_points\":TEST_POINTS\n    }\n    return pd.concat([pd.DataFrame([metadata]),df],axis=1)\n\n# Run one complete PINN experiment\ndef run_experiment(problem,epochs,neurons):\n    problem_root=RESULT_ROOT/(\"linear\" if problem[\"type\"]==\"Linear\" else \"nonlinear\")\n    exp_root=problem_root/f\"E{epochs}_N{neurons}\"\n    exp_root.mkdir(parents=True,exist_ok=True)\n\n    # Create a new model for each experiment configuration\n    model=build_model(neurons)\n    optimizer=tf.keras.optimizers.Adam(learning_rate=LEARNING_RATE)\n\n    # Set the initial condition for the first window\n    current_y0=tf.constant([problem[\"initial\"]],dtype=tf.float32)\n    loss_history=[]\n    all_t=[]\n    all_state=[]\n\n    # Divide the full time domain into sequential windows\n    window_edges=np.linspace(0,TOTAL_TIME,WINDOWS+1)\n    global_step=0\n\n    for w in range(WINDOWS):\n        t_start=float(window_edges[w])\n        t_end=float(window_edges[w+1])\n\n        # Generate collocation points for the current window\n        t_physics=tf.cast(tf.reshape(tf.linspace(t_start,t_end,PHYSICS_POINTS),(-1,1)),tf.float32)\n\n        # Define the initial point of the current window\n        t_init=tf.constant([[t_start]],dtype=tf.float32)\n\n        # Train the PINN over the current time window\n        for ep in range(epochs):\n            with tf.GradientTape() as tape:\n\n                # Calculate the physics loss\n                physics_res=physics_residual(model,t_physics,problem[\"id\"])\n                physics_loss=tf.reduce_mean(tf.square(physics_res))\n\n                # Calculate the initial-condition loss\n                state_init_pred=model(t_init,training=True)\n                ic_loss=tf.reduce_mean(tf.square(state_init_pred-current_y0))\n\n                # Combine physics and initial-condition losses\n                loss=physics_loss+IC_WEIGHT*ic_loss\n\n            # Update the model parameters\n            gradients=tape.gradient(loss,model.trainable_variables)\n            optimizer.apply_gradients(zip(gradients,model.trainable_variables))\n\n            # Save the training losses\n            global_step+=1\n            loss_history.append([global_step,w+1,ep+1,float(physics_loss.numpy()),float(ic_loss.numpy()),float(loss.numpy())])\n\n        # Generate PINN predictions for the current window\n        points_this_window=TEST_POINTS//WINDOWS+1\n        t_window=np.linspace(t_start,t_end,points_this_window).astype(np.float32)\n        state_window=model(tf.convert_to_tensor(t_window.reshape(-1,1),dtype=tf.float32),training=False).numpy()\n\n        # Remove duplicate points at window boundaries\n        if w>0:\n            t_window=t_window[1:]\n            state_window=state_window[1:]\n\n        all_t.extend(t_window)\n        all_state.extend(state_window)\n\n        # Use the predicted boundary state as the next window's initial condition\n        t_boundary=tf.constant([[t_end]],dtype=tf.float32)\n        current_y0=model(t_boundary,training=False)\n\n    # Convert PINN results to sorted NumPy arrays\n    t_nn=np.asarray(all_t,dtype=np.float64)\n    state_nn=np.asarray(all_state,dtype=np.float64)\n    order=np.argsort(t_nn)\n    t_nn=t_nn[order]\n    state_nn=state_nn[order]\n\n    # Calculate the independent RK4 reference solution\n    state_rk4=rk4_solution(t_nn,problem[\"id\"],problem[\"initial\"])\n\n    # Calculate PINN versus RK4 error metrics\n    error=state_nn-state_rk4\n    mse=float(np.mean(error**2))\n    rmse=float(np.sqrt(mse))\n    mae=float(np.mean(np.abs(error)))\n    relative_l2=float(np.linalg.norm(error)/np.linalg.norm(state_rk4))\n    max_error=float(np.max(np.abs(error)))\n\n    # Save the PINN output\n    pinn_df=add_metadata(pd.DataFrame({\"time\":t_nn,\"pinn_x\":state_nn[:,0],\"pinn_y\":state_nn[:,1]}),problem,epochs,neurons)\n    pinn_df.to_csv(exp_root/\"pinn_output.csv\",index=False)\n\n    # Save the inputs required for MATLAB RK4\n    matlab_df=add_metadata(pd.DataFrame({\"time\":t_nn,\"initial_x\":problem[\"initial\"][0],\"initial_y\":problem[\"initial\"][1]}),problem,epochs,neurons)\n    matlab_df.to_csv(exp_root/\"matlab_input.csv\",index=False)\n\n    # Save the Python RK4 reference for cross-checking\n    rk4_df=add_metadata(pd.DataFrame({\"time\":t_nn,\"rk4_x\":state_rk4[:,0],\"rk4_y\":state_rk4[:,1]}),problem,epochs,neurons)\n    rk4_df.to_csv(exp_root/\"rk4_reference.csv\",index=False)\n\n    # Save the complete training-loss history\n    loss_df=add_metadata(pd.DataFrame({\"global_step\":[x[0] for x in loss_history],\"window\":[x[1] for x in loss_history],\"epoch\":[x[2] for x in loss_history],\"physics_loss\":[x[3] for x in loss_history],\"ic_loss\":[x[4] for x in loss_history],\"total_loss\":[x[5] for x in loss_history]}),problem,epochs,neurons)\n    loss_df.to_csv(exp_root/\"epoch_loss.csv\",index=False)\n\n    # Save the comparison metrics\n    metrics_df=add_metadata(pd.DataFrame({\"mae\":[mae],\"rmse\":[rmse],\"mse\":[mse],\"relative_l2_error\":[relative_l2],\"max_absolute_error\":[max_error]}),problem,epochs,neurons)\n    metrics_df.to_csv(exp_root/\"metrics.csv\",index=False)\n\n    # Create the PINN versus RK4 plot\n    title=f'{problem[\"dimension\"]} {problem[\"type\"]} — {problem[\"source\"]} | PINN vs RK4\\n{problem[\"equation\"]}\\n{problem[\"ic\"]} | Epochs: {epochs} | Neurons: {neurons}'\n    plt.figure(figsize=(11,6))\n    plt.plot(t_nn,state_rk4[:,0],label=\"RK4 x(t)\",linewidth=2)\n    plt.plot(t_nn,state_nn[:,0],\"--\",label=\"PINN x(t)\",linewidth=2)\n    plt.plot(t_nn,state_rk4[:,1],label=\"RK4 y(t)\",linewidth=2)\n    plt.plot(t_nn,state_nn[:,1],\"--\",label=\"PINN y(t)\",linewidth=2)\n    plt.xlabel(\"Time\")\n    plt.ylabel(\"State\")\n    plt.title(title)\n    plt.grid(True)\n    plt.legend()\n    plt.tight_layout()\n    plt.savefig(exp_root/\"pinn_vs_rk4.png\",dpi=300,bbox_inches=\"tight\")\n    plt.close()\n\n    # Create the training-loss plot\n    loss_values=np.asarray([x[5] for x in loss_history])\n    plt.figure(figsize=(11,6))\n    plt.plot(np.arange(1,len(loss_values)+1),loss_values)\n    plt.yscale(\"log\")\n    plt.xlabel(\"Training Step\")\n    plt.ylabel(\"Total Loss\")\n    plt.title(f'{problem[\"dimension\"]} {problem[\"type\"]} — {problem[\"source\"]} | Training Loss\\n{problem[\"equation\"]}\\n{problem[\"ic\"]} | Epochs: {epochs} | Neurons: {neurons}')\n    plt.grid(True)\n    plt.tight_layout()\n    plt.savefig(exp_root/\"epoch_loss.png\",dpi=300,bbox_inches=\"tight\")\n    plt.close()\n\n    return {\"experiment\":f'{problem[\"id\"]}_E{epochs}_N{neurons}',\"equation\":problem[\"equation\"],\"dimension\":problem[\"dimension\"],\"problem_type\":problem[\"type\"],\"source\":problem[\"source\"],\"initial_condition\":problem[\"ic\"],\"epochs\":epochs,\"neurons\":neurons,\"mae\":mae,\"rmse\":rmse,\"mse\":mse,\"relative_l2_error\":relative_l2,\"max_absolute_error\":max_error}\n\n# Create the main result directory\nRESULT_ROOT.mkdir(parents=True,exist_ok=True)\n\n# Run all 2D equations across all configurations\nall_results=[]\nfor problem in PROBLEMS:\n    for epochs,neurons in CONFIGS:\n        print(f'Running {problem[\"id\"]} | Epochs={epochs} | Neurons={neurons}')\n        all_results.append(run_experiment(problem,epochs,neurons))\n\n# Save the complete experiment summary\nresults_df=pd.DataFrame(all_results)\nresults_df.to_csv(RESULT_ROOT/\"all_results.csv\",index=False)\n\n# Display the final experiment summary\ndisplay(results_df)\nprint(f\"\\nCompleted {len(all_results)} experiments.\")\nprint(f\"Results saved to: {RESULT_ROOT}\")\n\n# Display all generated plots\nprint(\"\\nDisplaying generated plots...\")\nfor problem in PROBLEMS:\n    problem_root=RESULT_ROOT/(\"linear\" if problem[\"type\"]==\"Linear\" else \"nonlinear\")\n    for epochs,neurons in CONFIGS:\n        exp_root=problem_root/f\"E{epochs}_N{neurons}\"\n        print(f'\\n{problem[\"id\"]} | Epochs={epochs} | Neurons={neurons}')\n        display(Image(filename=str(exp_root/\"pinn_vs_rk4.png\")))\n        display(Image(filename=str(exp_root/\"epoch_loss.png\")))","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null}]}